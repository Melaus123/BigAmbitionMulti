{
  "id": "T-UISHOTS",
  "title": "DEV palette capture - the DEV lever 'uiview' opens the game's OWN main-menu screens (start column, Load Game, Options first tab, New Game sheet, the delete-save HudConfirm) through their own button onClick, plus our MP submenu and lobby window as a before-picture, and 'screenshot ui-<view>' captures each. Host only; the client idles at its main menu. NO save, no world load. Keep the host window unfocused but NOT minimised (a minimised window does not render).",
  "preconditions": "Dev build with the 'uiview' lever (TestDrive.cs). At least one save on disk so Load Game lists something (the lever opens the window either way).",
  "instances": 2,
  "vars": {},
  "oracles_absent": [
    "\\[TestDrive\\] uiview: ",
    "\\[TestDrive\\] screenshot: ",
    "HudConfirm is already open"
  ],
  "oracles_report": [
    "\\[TestDrive\\] uiview ",
    "\\[TestDrive\\] screenshot "
  ],
  "steps": [
    {
      "seq": 1,
      "role": "both",
      "cmd": "mark TEST UISHOTS START",
      "expect_result": "OK MARK"
    },
    {
      "seq": 2,
      "role": "h",
      "sleep_s": 20,
      "note": "let the main menu finish building (menu injection, theme frontload) before the first open"
    },
    {
      "seq": 3,
      "role": "h",
      "cmd": "uiview start",
      "expect_result": "^OK uiview start: closed:",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[TestDrive\\] uiview start: ",
          "within_s": 10
        }
      ]
    },
    {
      "seq": 4,
      "role": "h",
      "sleep_s": 2,
      "note": "let the start view animate in"
    },
    {
      "seq": 5,
      "role": "h",
      "cmd": "screenshot ui-start",
      "expect_result": "^OK screenshot queued",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[TestDrive\\] screenshot .*shot-ui-start\\.png",
          "within_s": 10
        }
      ]
    },
    {
      "seq": 6,
      "role": "h",
      "cmd": "uiview load",
      "expect_result": "^OK uiview load: .*active=True",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[TestDrive\\] uiview load: ",
          "within_s": 10
        }
      ]
    },
    {
      "seq": 7,
      "role": "h",
      "sleep_s": 2,
      "note": "let the load view animate in"
    },
    {
      "seq": 8,
      "role": "h",

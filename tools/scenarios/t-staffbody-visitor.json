{
  "id": "T-STAFFBODY-VISITOR",
  "title": "H-STAFFBODY-1 control: a PLAIN (unmerged) visitor in another player's staffed shop still sees workers after the fix - the game's own staff where the visitor holds the owner's roster + schedule, the hired-staff stand-in where it does not. NO save.",
  "preconditions": "Fixture save1 (host melaus, client Client1, NOT merged). Dev build with staffbody / employees / enterbuilding / exitbuilding / skipvote / skipstate / pause (BAMP_DEV). THE SHOP is Client1's gym at vars.shop (t-skipstandin uses it as Client1's gym). The setup skip goes to 14:20 next day so the shop is open and staffed. NOTHING is saved.",
  "instances": 2,
  "vars": {
    "clientPid": "Client1",
    "hostPid": "melaus",
    "session": "save1",
    "shop": "21 ba:street_fourthstreet"
  },
  "oracles_absent": [
    "\\[TickIso\\]",
    "\\[Guard\\]",
    "(?<!swallowed )NullReferenceException",
    "\\[SynthStaff\\] (holds-owner-staff|retire redundant)"
  ],
  "oracles_report": [
    "\\[SynthStaff\\] ",
    "\\[StaffRoster\\] applied",
    "\\[StaffEval\\] "
  ],
  "steps": [
    {
      "seq": 1,
      "role": "h",
      "cmd": "host",
      "expect_result": "^OK"
    },
    {
      "seq": 2,
      "role": "c",
      "cmd": "join",
      "expect_result": "^OK"
    },
    {
      "seq": 3,
      "role": "h",
      "cmd": "hostload ${session}",
      "expect_result": "^OK"
    },
    {
      "seq": 4,
      "role": "both",
      "cmd": "mark TEST T-STAFFBODY-VISITOR START",
      "expect_result": "OK MARK"
    },
    {
      "seq": 5,
      "role": "h",
      "sleep_s": 60,
      "note": "both worlds settle; the owner's roster publish (30 s) and duty scan (5 s) run"
    },
    {
      "seq": 6,
      "role": "h",
      "cmd": "status",
      "expect_result": "settled=True"
    },
    {
      "seq": 7,
      "role": "c",
      "cmd": "status",
      "expect_result": "settled=True"
    },
    {
      "seq": 8,
      "role": "h",
      "cmd": "pause off",
      "expect_result": "^OK"
    },
    {
      "seq": 9,
      "role": "c",
      "cmd": "pause off",
      "expect_result": "^OK"
    },
    {
      "seq": 10,
      "role": "h",
      "cmd": "exitbuilding",
      "abort_on_fail": false,
      "note": "report-only: an outdoor player only warns"
    },
    {
      "seq": 11,
      "role": "c",
      "cmd": "exitbuilding",
      "abort_on_fail": false
    },
    {
      "seq": 12,
      "role": "h",
      "sleep_s": 8
    },
    {
      "seq": 13,
      "role": "h",
      "cmd": "skipvote 14:20",
      "expect_result": "^OK skipvote goal="
    },
    {
      "seq": 14,
      "role": "c",
      "cmd": "skipvote 14:20",
      "expect_result": "^OK skipvote goal=",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[Rest\\] CONSENSUS \\(2/2\\)",
          "within_s": 60
        }
      ],
      "note": "the setup skip, taken OUTDOORS with no shop occupied"
    },
    {
      "seq": 15,
      "role": "h",
      "sleep_s": 40
    },
    {
      "seq": 16,
      "role": "h",
      "cmd": "skipstate",
      "expect_result": "active=False"
    },
    {
      "seq": 17,
      "role": "h",
      "cmd": "skipvote off",
      "expect_result": "^OK skipvote goal=-"
    },
    {
      "seq": 18,
      "role": "c",
      "cmd": "skipvote off",
      "expect_result": "^OK skipvote goal=-"
    },
    {
      "seq": 19,
      "role": "h",
      "sleep_s": 5
    },
    {
      "seq": 20,
      "role": "c",
      "cmd": "enterbuilding ${shop}",
      "expect_result": "^OK enterbuilding",
      "note": "the OWNER (Client1) stands in his own shop"
    },
    {
      "seq": 21,
      "role": "h",
      "cmd": "enterbuilding ${shop}",
      "expect_result": "^OK enterbuilding",
      "note": "the other player stands in the same shop"
    },
    {
      "seq": 22,
      "role": "h",
      "sleep_s": 25,
      "note": "stations evaluate natively; the roster-apply pass (10 s) retires any redundant stand-in"
    },
    {
      "seq": 23,
      "role": "h",
      "cmd": "pause on",
      "expect_result": "^OK",
      "note": "the world clock STOPS so every read below is taken at the SAME game minute on both machines"
    },
    {
      "seq": 24,
      "role": "c",
      "cmd": "pause on",
      "expect_result": "^OK"
    },
    {
      "seq": 25,
      "role": "h",
      "sleep_s": 3
    },
    {
      "seq": 26,
      "role": "c",
      "cmd": "staffbody ${shop}",
      "expect_result": "synth=0 dutyRecs=0 .*stations=[1-9]\\d* bodies=[1-9]\\d* bodyNoShift=0 ",
      "capture": {
        "ownerBodies": "bodies=(\\d+)",
        "ownerOcc": "occ=(\\[[^\\]]*\\])"
      },
      "note": "PREMISE: the OWNER's shop is staffed right now (bodies >= 1)"
    },
    {
      "seq": 27,
      "role": "h",
      "cmd": "staffbody ${shop}",
      "expect_result": "bodies=${ownerBodies} ",
      "note": "THE VISITOR SEES WORKERS: as many bodies as the owner - the game's own staff when it holds the roster + schedule (holds=True, synth=0), else the stand-ins (holds=False, synth>=1)"
    },
    {
      "seq": 28,
      "role": "h",
      "cmd": "staffbody ${shop}",
      "expect_result": "occ=${ownerOcc}",
      "abort_on_fail": false,
      "note": "report-only: equal when the visitor shows the owner's real people (a stand-in carries a BAMP_DUTY id instead)"
    },
    {
      "seq": 29,
      "role": "h",
      "cmd": "employees ${shop}",
      "expect_result": "^OK",
      "note": "report: the visitor's records for the shop"
    },
    {
      "seq": 30,
      "role": "c",
      "cmd": "employees ${shop}",
      "expect_result": "^OK",
      "note": "report: the owner's records"
    },
    {
      "seq": 31,
      "role": "h",
      "cmd": "pause off",
      "expect_result": "^OK"
    },
    {
      "seq": 32,
      "role": "c",
      "cmd": "pause off",
      "expect_result": "^OK"
    }
  ]
}

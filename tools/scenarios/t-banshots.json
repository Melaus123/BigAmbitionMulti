{
  "id": "T-BANSHOTS",
  "title": "BAN-PLAYERS-1 build C2 screenshots: B6a/B6b (DEV views over the main menu), B5 lobby + B2/B3 over the lobby, B1/B2/B2b/B3 (2 rows and empty)/B4 on the Business page, all opened through the screens' own click paths. Run at 1920x1080 (window key) and 1280x720 (BAMP_RIG_WINDOW).",
  "preconditions": "Dev build with the 'banui' lever. Fixture save1 (host melaus, client Client1). Two DEV saved bans (devaddr = 'Joined by IP', devsteam = 'Steam account') make B3's two rows; both are unbanned through B3 itself.",
  "instances": 2,
  "window": "1920x1080",
  "vars": {
    "clientPid": "Client1",
    "hostPid": "melaus",
    "session": "save1"
  },
  "oracles_absent": [
    "NullReferenceException",
    "\\[BanUI\\] (open ban|open list|rebuild|click|tick|notice): ",
    "\\[Hub\\] (TickHubWindow|rebuild|ban button|banned button):",
    "\\[MenuUI\\] lobby (tick|refresh):"
  ],
  "oracles_report": [
    "\\[BanUI\\]",
    "\\[TestDrive\\] screenshot"
  ],
  "steps": [
    {
      "role": "all",
      "cmd": "mark TEST BANSHOTS START",
      "expect_result": "OK MARK",
      "seq": 1
    },
    {
      "role": "h",
      "cmd": "unban all",
      "expect_result": "^OK unbanned \\d+ left=0",
      "seq": 2
    },
    {
      "role": "h",
      "cmd": "banui notice",
      "expect_result": "^OK banui notice armed",
      "seq": 3
    },
    {
      "role": "h",
      "sleep_s": 3,
      "seq": 4
    },
    {
      "role": "h",
      "cmd": "banui state",

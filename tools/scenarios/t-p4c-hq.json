{
  "id": "T-P4C-HQ",
  "title": "phase 4c part 1, two players: after each member's paperwork publishes, the other machine's plan registry holds that member's five HQ plan families (screen-layer; the plans verb lists them); inert before the merge; cleared on dissolve; ends dissolved",
  "preconditions": "Fixture save1. Build with phase 4c part 1 deployed. The UI overlay itself (rows drawn on a partner HQ's tab) cannot be driven by the rig; this scenario covers the registry: receipt, the verb, the clear. Counts per family depend on the fixture and are reported, not asserted. Ends dissolved.",
  "instances": 2,
  "vars": {
    "clientPid": "Client1",
    "hostPid": "melaus",
    "session": "save1"
  },
  "oracles_absent": [
    "NullReferenceException",
    "HarmonyException",
    "Patching exception",
    "\\[Merger\\] accept .* REFUSED",
    "upload SKIPPED",
    "\\[Plans\\] receive:",
    "\\[Plans\\] row .*: "
  ],
  "oracles_report": [
    "\\[Plans\\] received",
    "\\[Plans\\] cleared",
    "\\[Plans\\] shown",
    "\\[Merger\\] .* edit on partner HQ"
  ],
  "steps": [
    {
      "seq": 1,
      "role": "h",
      "cmd": "host",
      "expect_result": "^OK"
    },
    {
      "seq": 2,
      "role": "c",
      "cmd": "join",
      "expect_result": "^OK"
    },
    {
      "seq": 3,
      "role": "h",
      "cmd": "hostload ${session}",
      "expect_result": "^OK"
    },
    {
      "seq": 4,
      "role": "both",
      "cmd": "mark TEST P4C-HQ START",
      "expect_result": "OK MARK"
    },
    {
      "seq": 5,
      "role": "h",
      "cmd": "plans",
      "expect_result": "^OK plans own=\\{pricing:\\d+,logistics:\\d+,purchasing:\\d+,hr:\\d+,headhunter:\\d+\\} partners=\\{\\}$",
      "note": "INERT before the merge: no partner registry"
    },
    {
      "seq": 6,
      "role": "h",
      "cmd": "merge propose ${clientPid}",
      "expect_result": "OK merge propose sent"
    },
    {
      "seq": 7,
      "role": "h",
      "sleep_s": 1
    },
    {
      "seq": 8,
      "role": "h",
      "cmd": "offers",
      "expect_result": "pending=\\[${clientPid}<-${hostPid}\\]"
    },
    {
      "seq": 9,
      "role": "c",
      "cmd": "merge accept",
      "expect_result": "OK merge accept sent"
    },
    {
      "seq": 10,
      "role": "h",
      "sleep_s": 3
    },
    {
      "seq": 11,
      "role": "h",
      "cmd": "mergestatus",
      "expect_result": "member=True.*flipped=[1-9]"
    },
    {
      "seq": 12,
      "role": "h",
      "sleep_s": 30,
      "note": "the client's world needs to settle before its paperwork publish is accepted (wave-4 lesson)"
    },
    {
      "seq": 13,
      "role": "c",
      "cmd": "status",
      "expect_result": "settled=True"
    },
    {
      "seq": 14,
      "role": "c",
      "cmd": "paperwork push",
      "expect_result": "^OK paperwork pushed day=\\d+ businesses=[1-9]",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[Plans\\] received ${clientPid}: pricing \\d+ logistics \\d+ purchasing \\d+ hr \\d+ headhunter \\d+",
          "within_s": 20
        }
      ],
      "note": "the client's publish reaches the host store and fans out (CompanyLists 213, now five families): the host's registry takes the client's plans"
    },
    {
      "seq": 15,
      "role": "h",
      "cmd": "paperwork push",
      "expect_result": "^OK paperwork pushed day=\\d+ businesses=[1-9]",
      "expect_log": [
        {
          "role": "c",
          "regex": "\\[Plans\\] received ${hostPid}: pricing \\d+ logistics \\d+ purchasing \\d+ hr \\d+ headhunter \\d+",
          "within_s": 20
        }
      ],
      "note": "and the host's publish lands in the client's registry"
    },
    {
      "seq": 16,
      "role": "h",
      "sleep_s": 3
    },
    {
      "seq": 17,
      "role": "h",
      "cmd": "plans",
      "expect_result": "^OK plans own=\\{pricing:0,logistics:2,purchasing:3,hr:3,headhunter:2\\} partners=\\{${clientPid}:\\{pricing:0,logistics:2,purchasing:4,hr:6,headhunter:2\\}\\}$",
      "note": "host view: exactly one partner (the client) with all five families; own= must NOT count the partner's installed logistics display copies (run 1 on the r1 build read logistics:4 here; the fixture's true counts are melaus 0/2/3/3/2 and Client1 0/2/4/6/2)"
    },
    {
      "seq": 18,
      "role": "c",
      "cmd": "plans",
      "expect_result": "^OK plans own=\\{pricing:\\d+,logistics:\\d+,purchasing:\\d+,hr:\\d+,headhunter:\\d+\\} partners=\\{${hostPid}:\\{pricing:\\d+,logistics:\\d+,purchasing:\\d+,hr:\\d+,headhunter:\\d+\\}\\}$",
      "note": "client view: exactly one partner (the host)"
    },
    {
      "seq": 19,
      "role": "c",
      "cmd": "plans ${hostPid}",
      "expect_result": "^OK plans '${hostPid}' pricing:\\d+ logistics:\\d+ purchasing:\\d+ hr:\\d+ headhunter:\\d+$",
      "note": "per-owner form; no 'overlay suspended' suffix (nobody is standing in)"
    },
    {
      "seq": 20,
      "role": "c",
      "cmd": "merge leave",
      "expect_result": "OK merge leave sent",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[Plans\\] cleared \\(",
          "within_s": 15
        }
      ],
      "note": "FIXTURE HYGIENE: end dissolved; the host's registry clears"
    },
    {
      "seq": 21,
      "role": "h",
      "sleep_s": 3
    },
    {
      "seq": 22,
      "role": "h",
      "cmd": "mergestatus",
      "expect_result": "member=False.*flipped=0"
    },
    {
      "seq": 23,
      "role": "h",
      "cmd": "plans",
      "expect_result": "^OK plans own=\\{pricing:\\d+,logistics:\\d+,purchasing:\\d+,hr:\\d+,headhunter:\\d+\\} partners=\\{\\}$",
      "note": "dissolved: the registry is empty again"
    },
    {
      "seq": 24,
      "role": "h",
      "cmd": "save",
      "expect_result": "^OK"
    },
    {
      "seq": 25,
      "role": "both",
      "cmd": "mark TEST P4C-HQ END",
      "expect_result": "OK MARK"
    }
  ]
}

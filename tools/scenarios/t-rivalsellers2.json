      "expect_result": "^OK stockof .*ba:itemname_beer:[1-9].*ba:itemname_whisky:[1-9]",
      "note": "PREMISE ASSERTED: the client's own liquor store in Murray Hill (found by run 1's providers-scan) holds the measured items on its shelves"
    },
    {
      "seq": 8,

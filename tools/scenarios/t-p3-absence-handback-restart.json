{
  "id": "T-P3-HB-R",
  "title": "ABSENCE-HANDBACK-1 fold 2 (D1) restart leg (3P, client stand-in): as leg B up to the stand-in's accepted absence work (the host records its world copy as the absence truth); then the host SAVES, the stand-in leaves, the host RESTARTS and reloads with the OWNER rejoining first: the restored mark carries TruthInWorld, the host's world copy becomes the stored copy, and the owner is handed back exactly the stand-in's absence stock (fingerprints equal) - the owner's OTHER shops (never in TruthInWorld) keep today's no-copy rule (report-only oracle)",
  "preconditions": "Fixture save1 (host melaus/Prabaha, client Client1/REX) plus role d (Client2, joins as a NEW player - charconfirm armed before hostload), as T-P3-3. The newcomer has no businesses, so Client2 is the stand-in by the longest-online rule (the host is not a member).  ONE mid-run host save into the rig's own save copy (fixture_reset re-prepares it before every run); ends dissolved. The stand-in stays away after the restart: with it online the reconcile drops the restored mark (an offline owner's addresses do not resolve after a restart - reported leftover).",
  "instances": 3,
  "vars": {
    "clientPid": "Client1",
    "hostPid": "melaus",
    "dPid": "Client2",
    "session": "save1"
  },
  "oracles_absent": [
    "NullReferenceException",
    "\\[Merger\\] accept .* REFUSED",
    "upload SKIPPED",
    "\\[Paperwork\\] .* refused",
    "hand-back of .* acknowledged .*MISMATCH",
    "OwnerSnapshot rejected: player='Client1'",
    "\\[Absence\\] hand-back ack for .* ignored",
    "hand-back of .* REFUSED by"
  ],
  "oracles_report": [
    "\\[Paperwork\\]",
    "\\[Absence\\]",
    "\\[EconProbe\\] wallet",
    "host holds no copy",
    "queued hand-back of",
    "re-queued for",
    "unload on quit"
  ],
  "steps": [
    {
      "role": "h",
      "cmd": "host",
      "expect_result": "^OK",
      "seq": 1
    },
    {
      "role": "c",
      "cmd": "join",
      "expect_result": "^OK",
      "seq": 2
    },
    {
      "role": "d",
      "cmd": "join",
      "expect_result": "^OK",
      "seq": 3
    },
    {
      "role": "d",
      "cmd": "charconfirm",
      "expect_result": "^OK armed",
      "seq": 4
    },
    {
      "role": "h",
      "cmd": "hostload ${session}",
      "expect_result": "^OK",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[BAMP\\] \\[LoadProf\\].*HOST ReleaseStartupHold \\(all players world-ready\\)",
          "within_s": 300
        },
        {
          "role": "h",
          "regex": "\\[BAMP\\] \\[Lifecycle\\] WorldReady",
          "within_s": 60
        }
      ],
      "seq": 5
    },
    {
      "role": "all",
      "cmd": "mark TEST P3-HB-B START",
      "expect_result": "OK MARK",
      "seq": 6
    },
    {
      "role": "c",
      "cmd": "merge propose ${dPid}",
      "expect_result": "OK merge propose sent",
      "seq": 7
    },
    {
      "role": "h",
      "sleep_s": 1,
      "seq": 8
    },
    {
      "role": "h",
      "cmd": "offers",
      "expect_result": "pending=\\[${dPid}<-${clientPid}\\]",
      "seq": 9
    },
    {
      "role": "d",
      "cmd": "merge accept",
      "expect_result": "OK merge accept sent",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[BAMP\\] \\[Merger\\] FORMED group",
          "within_s": 20
        }
      ],
      "seq": 10
    },
    {
      "role": "h",
      "sleep_s": 3,
      "seq": 11
    },
    {
      "role": "d",
      "cmd": "mergestatus",
      "expect_result": "member=True.*flipped=[1-9]",
      "capture": {
        "clientShop": "keys=\\['([^']+)'"
      },
      "note": "the newcomer sees Client1's buildings flipped",
      "seq": 12
    },
    {
      "role": "h",
      "cmd": "mergestatus",
      "expect_result": "member=False",
      "note": "the host is NOT in the company",
      "seq": 13
    },
    {
      "role": "c",
      "cmd": "paperwork push",
      "expect_result": "^OK paperwork pushed day=\\d+ businesses=[1-9]",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[Paperwork\\] stored for '${clientPid}'",
          "within_s": 15
        }
      ],
      "seq": 14
    },
    {
      "role": "d",
      "cmd": "paperwork push",
      "expect_result": "^OK paperwork pushed day=\\d+ businesses=0",
      "note": "the newcomer owns nothing yet",
      "seq": 15
    },
    {
      "role": "c",
      "cmd": "stockof ${clientShop}",
      "expect_result": "^OK stockof .*items=\\[.+\\]",
      "capture": {
        "predropStock": "items=\\[([^\\]]*)\\]"
      },
      "seq": 16
    },
    {
      "role": "h",
      "cmd": "mark pre-drop baseline",
      "expect_result": "OK MARK",
      "note": "sets the host's search baseline before the disconnect",
      "seq": 17
    },
    {
      "role": "c",
      "drop": true,
      "note": "the business-owning member drops out",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[Absence\\] hand-over of '${clientPid}' \\(\\d+ addresses, \\d+ bytes paperwork\\) -> '${dPid}'",
          "within_s": 90
        },
        {
          "role": "d",
          "regex": "\\[Absence\\] simulating '${clientShop}' for '${clientPid}'",
          "within_s": 90
        }
      ],
      "seq": 18
    },
    {
      "role": "h",
      "cmd": "mark client dropped",
      "expect_result": "OK MARK",
      "note": "the host designates the other client and sends the hand-over; the simulator applies it (the take-over evidence is asserted on the drop step itself: it fires in the same second as the disconnect)",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[Absence\\] stand-in '${dPid}' applied the host's copy of '${clientShop}' - its uploads of it are accepted",
          "within_s": 90,
          "since_prev_step": true
        }
      ],
      "seq": 19
    },
    {
      "role": "d",
      "cmd": "absence",
      "expect_result": "^OK absence marks=\\[${clientPid}->${dPid}: .*\\] simulating_here=\\[.*${clientShop}",
      "seq": 20
    },
    {
      "role": "h",
      "cmd": "absence",
      "expect_result": "^OK absence marks=\\[${clientPid}->${dPid}( ownerBack=\\d)?: .*\\] simulating_here=\\[\\]",
      "note": "the host tracks the mark but simulates nothing itself",
      "seq": 21
    },
    {
      "role": "d",
      "cmd": "shelftake ${clientShop}",
      "expect_result": "^OK shelftake",
      "expect_log": [
        {
          "role": "d",
          "regex": "\\[BStore\\] owner applied TAKE",
          "within_s": 30
        },
        {
          "role": "h",
          "regex": "\\[Absence\\] '${clientShop}': the host's world copy is the absence truth for '${clientPid}'",
          "within_s": 40
        }
      ],
      "note": "the CLIENT stand-in takes stock",
      "seq": 22
    },
    {
      "role": "d",
      "cmd": "shelftake ${clientShop}",
      "expect_result": "^OK shelftake",
      "expect_log": [
        {
          "role": "d",
          "regex": "\\[BStore\\] owner applied TAKE",
          "within_s": 30
        }
      ],
      "seq": 23
    },
    {
      "role": "d",
      "cmd": "dirtseed ${clientShop} 60 9",
      "expect_result": "^OK dirtseed .*dirtyNow=[1-9]",
      "note": "stand-in dirt (reaches the host by the final flush at the latest)",
      "seq": 24
    },
    {
      "role": "h",
      "sleep_s": 8,
      "note": "the stand-in's upload of the take reaches the host",
      "seq": 25
    },
    {
      "role": "d",
      "cmd": "stockof ${clientShop}",
      "expect_result": "^OK stockof",
      "refute_result": "items=\\[${predropStock}\\]",
      "capture": {
        "dAbsStock": "items=\\[([^\\]]*)\\]"
      },
      "note": "premise: the stand-in's stock moved",
      "seq": 26
    },
    {
      "role": "h",
      "cmd": "stockof ${clientShop}",
      "expect_result": "items=\\[${dAbsStock}\\]",
      "note": "F4: the host ACCEPTED the client stand-in's upload (it used to refuse it: ABSENCE-3P-UPLOAD-1)",
      "abort_on_fail": false,
      "seq": 27
    },
    {
      "role": "h",
      "sleep_s": 20,
      "seq": 28
    },
    {
      "role": "d",
      "cmd": "paperwork push",
      "expect_result": "^OK paperwork pushed day=\\d+ businesses=[1-9]",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[Paperwork\\] stored for '${dPid}'",
          "within_s": 15
        }
      ],
      "note": "the simulator now publishes the absent member's businesses under its own bundle",
      "seq": 29
    },
    {
      "role": "h",
      "cmd": "save",
      "expect_result": "^OK",
      "note": "the save holds the host's world copy (the stand-in's accepted work) and the mark's TruthInWorld",
      "seq": 30
    },
    {
      "role": "h",
      "sleep_s": 20,
      "seq": 31
    },
    {
      "role": "d",
      "cmd": "leavegame menu",
      "expect_result": "^OK leavegame menu",
      "note": "the stand-in leaves before the host goes down",
      "seq": 32
    },
    {
      "role": "d",
      "sleep_s": 10,
      "seq": 33
    },
    {
      "role": "h",
      "drop": true,
      "note": "HOST RESTART during the absence",
      "seq": 34
    },
    {
      "role": "h",
      "relaunch": true,
      "seq": 35
    },
    {
      "role": "h",
      "sleep_s": 20,
      "seq": 36
    },
    {
      "role": "h",
      "cmd": "host",
      "expect_result": "^OK",
      "seq": 37
    },
    {
      "role": "c",
      "relaunch": true,
      "note": "the absent owner returns (first, into the restarted host)",
      "seq": 38
    },
    {
      "role": "c",
      "cmd": "join",
      "expect_result": "^OK",
      "seq": 39
    },
    {
      "role": "h",
      "cmd": "hostload ${session}",
      "expect_result": "^OK",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[Absence\\] restored mark of '${clientPid}': the host's world copy is the absence truth for [1-9]",
          "within_s": 300
        },
        {
          "role": "h",
          "regex": "\\[BAMP\\] \\[LoadProf\\].*HOST ReleaseStartupHold \\(all players world-ready\\)",
          "within_s": 300
        },
        {
          "role": "h",
          "regex": "\\[BAMP\\] \\[Lifecycle\\] WorldReady",
          "within_s": 60
        }
      ],
      "seq": 40
    },
    {
      "role": "h",
      "cmd": "mark TEST P3-HB-R RETURN",
      "expect_result": "OK MARK",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[Absence\\] owner '${clientPid}' returned",
          "within_s": 150,
          "since_prev_step": true
        },
        {
          "role": "h",
          "regex": "\\[Absence\\] '${clientShop}' \\(for '${clientPid}'\\): no stored copy \\(host restart\\) - the host's world copy is the recorded absence truth",
          "within_s": 150,
          "since_prev_step": true
        },
        {
          "role": "h",
          "regex": "\\[Absence\\] return to '${clientPid}'",
          "within_s": 150,
          "since_prev_step": true
        },
        {
          "role": "h",
          "regex": "\\[Absence\\] hand-back '${clientShop}' -> '${clientPid}' sent=\\[items=[1-9]",
          "within_s": 180,
          "since_prev_step": true
        },
        {
          "role": "h",
          "regex": "\\[Absence\\] hand-back of '${clientShop}' acknowledged by '${clientPid}' - hold released",
          "within_s": 150,
          "since_prev_step": true
        },
        {
          "role": "h",
          "regex": "\\[Absence\\] return of '${clientPid}' acknowledged - mark cleared",
          "within_s": 150,
          "since_prev_step": true
        }
      ],
      "seq": 41
    },
    {
      "role": "h",
      "cmd": "absence",
      "expect_result": "returned=\\[.+\\]",
      "expect_log": [
        {
          "role": "c",
          "regex": "\\[Absence\\] return applied: \\d+ address",
          "within_s": 90
        },
        {
          "role": "c",
          "regex": "\\[Absence\\] hand-back applied '${clientShop}' fp=\\[items=[1-9]",
          "within_s": 90
        }
      ],
      "seq": 42
    },
    {
      "role": "h",
      "cmd": "absence fp ${clientShop}",
      "expect_result": "^OK absence fp .*sent=\\[items=[1-9].*mismatch=0 held=0",
      "capture": {
        "sentFp": "sent=\\[([^\\]]+)\\]"
      },
      "seq": 43
    },
    {
      "role": "c",
      "cmd": "absence fp ${clientShop}",
      "expect_result": "applied=\\[${sentFp}\\]",
      "note": "owner-applied fingerprint == the one the host sent",
      "abort_on_fail": false,
      "seq": 44
    },
    {
      "role": "c",
      "cmd": "stockof ${clientShop}",
      "expect_result": "items=\\[${dAbsStock}\\]",
      "note": "the owner has the stand-in's (pre-restart) absence stock, from the host's saved world copy",
      "abort_on_fail": false,
      "seq": 45
    },
    {
      "role": "c",
      "cmd": "interiorfp ${clientShop}",
      "expect_result": "^OK interiorfp",
      "capture": {
        "cFp": "fp=\\[([^\\]]+)\\]"
      },
      "seq": 46
    },
    {
      "role": "h",
      "cmd": "interiorfp ${clientShop}",
      "expect_result": "fp=\\[${cFp}\\]",
      "note": "host == owner after the return",
      "abort_on_fail": false,
      "seq": 47
    },
    {
      "role": "c",
      "cmd": "merge leave",
      "expect_result": "OK merge leave sent",
      "note": "FIXTURE HYGIENE: the pair dissolves",
      "seq": 48
    },
    {
      "role": "h",
      "sleep_s": 3,
      "seq": 49
    },
    {
      "role": "h",
      "cmd": "mark TEST P3-HB-R END",
      "expect_result": "OK MARK",
      "seq": 50
    }
  ]
}
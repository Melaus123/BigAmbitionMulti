{
  "id": "T-P2-PRICES",
  "title": "phase-2 route wave 1: a member's price edit on a partner shop lands on the owner and comes back through the publish; stop-gap refusals log",
  "preconditions": "Fixture save1 (host melaus/Prabaha, client Client1/REX). Dev build with the phase-2 price route and the prices/setprice verbs (brief-p2-route-prices.md result strings) - re-check the regexes against the builder's report before the first run. Product keys are captured from the owner's own 'prices' output. Run 1 lesson: the owner's 'applied' line is the [SharedShop] wording when a DIRECT Business grant also exists in the fixture (save1 carries one from Client1 to melaus); the regex accepts either wording.",
  "instances": 2,
  "vars": {
    "clientPid": "Client1",
    "hostPid": "melaus",
    "session": "save1",
    "newPrice": "12.34",
    "newPrice2": "23.45"
  },
  "oracles_absent": [
    "NullReferenceException",
    "\\[Merger\\] accept .* REFUSED",
    "upload SKIPPED",
    "price edit .* refused"
  ],
  "oracles_report": [
    "\\[Merger\\] price edit",
    "\\[Merger\\] .* refused - company building",
    "logistics plan .* skipped"
  ],
  "steps": [
    {
      "seq": 1,
      "role": "h",
      "cmd": "host",
      "expect_result": "^OK"
    },
    {
      "seq": 2,
      "role": "c",
      "cmd": "join",
      "expect_result": "^OK"
    },
    {
      "seq": 3,
      "role": "h",
      "cmd": "hostload ${session}",
      "expect_result": "^OK",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[BAMP\\] \\[LoadProf\\].*HOST ReleaseStartupHold \\(all players world-ready\\)",
          "within_s": 240
        },
        {
          "role": "h",
          "regex": "\\[BAMP\\] \\[Lifecycle\\] WorldReady",
          "within_s": 60
        }
      ]
    },
    {
      "seq": 4,
      "role": "both",
      "cmd": "mark TEST P2-PRICES START",
      "expect_result": "OK MARK"
    },
    {
      "seq": 5,
      "role": "h",
      "cmd": "merge propose ${clientPid}",
      "expect_result": "OK merge propose sent"
    },
    {
      "seq": 6,
      "role": "h",
      "sleep_s": 1
    },
    {
      "seq": 7,
      "role": "h",
      "cmd": "offers",
      "expect_result": "pending=\\[${clientPid}<-${hostPid}\\]"
    },
    {
      "seq": 8,
      "role": "c",
      "cmd": "merge accept",
      "expect_result": "OK merge accept sent",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[BAMP\\] \\[Merger\\] FORMED group",
          "within_s": 20
        }
      ]
    },
    {
      "seq": 9,
      "role": "h",
      "sleep_s": 3
    },
    {
      "seq": 10,
      "role": "h",
      "cmd": "mergestatus",
      "expect_result": "member=True.*flipped=[1-9]",
      "capture": {
        "clientShop": "keys=\\['([^']+)'"
      }
    },
    {
      "seq": 11,
      "role": "c",
      "cmd": "mergestatus",
      "expect_result": "member=True.*flipped=[1-9]",
      "capture": {
        "hostShop": "keys=\\['([^']+)'"
      }
    },
    {
      "seq": 12,
      "role": "h",
      "cmd": "prices ${hostShop}",
      "expect_result": "^OK prices addr='${hostShop}' n=[1-9]",
      "capture": {
        "hostProduct": "\\| ([^=|]+)="
      },
      "note": "the OWNER's own shop: first product key captured"
    },
    {
      "seq": 13,
      "role": "c",
      "cmd": "setprice ${hostShop} ${hostProduct} ${newPrice}",
      "expect_result": "^OK setprice addr='${hostShop}' product='${hostProduct}' value=${newPrice} routed=True",
      "expect_log": [
        {
          "role": "c",
          "regex": "\\[Merger\\] price edit routed to owner '${hostPid}' for '${hostShop}'",
          "within_s": 5
        },
        {
          "role": "h",
          "regex": "(\\[Merger\\] price edit applied for '${hostShop}' from '${clientPid}'|\\[SharedShop\\] '${clientPid}' set .* at '${hostShop}' to .* applied)",
          "within_s": 15
        }
      ],
      "note": "the MEMBER edits the partner's shop from across town: routed, applied on the owner"
    },
    {
      "seq": 14,
      "role": "h",
      "sleep_s": 3
    },
    {
      "seq": 15,
      "role": "h",
      "cmd": "prices ${hostShop}",
      "expect_result": "\\| ${hostProduct}=${newPrice}( |$)",
      "note": "the owner's shop carries the member's price"
    },
    {
      "seq": 16,
      "role": "c",
      "cmd": "prices ${hostShop}",
      "expect_result": "\\| ${hostProduct}=${newPrice}( |$)",
      "note": "the member's copy shows the same value after the owner's publish (one source of truth)"
    },
    {
      "seq": 17,
      "role": "h",
      "sleep_s": 35
    },
    {
      "seq": 18,
      "role": "c",
      "cmd": "prices ${hostShop}",
      "expect_result": "\\| ${hostProduct}=${newPrice}( |$)",
      "note": "no snap-back after the owner's ~30 s re-assert window"
    },
    {
      "seq": 19,
      "role": "c",
      "cmd": "prices ${clientShop}",
      "expect_result": "^OK prices addr='${clientShop}' n=[1-9]",
      "capture": {
        "clientProduct": "\\| ([^=|]+)="
      }
    },
    {
      "seq": 20,
      "role": "h",
      "cmd": "setprice ${clientShop} ${clientProduct} ${newPrice2}",
      "expect_result": "^OK setprice addr='${clientShop}' product='${clientProduct}' value=${newPrice2} routed=True",
      "expect_log": [
        {
          "role": "c",
          "regex": "(\\[Merger\\] price edit applied for '${clientShop}' from '${hostPid}'|\\[SharedShop\\] '${hostPid}' set .* at '${clientShop}' to .* applied)",
          "within_s": 15
        }
      ],
      "note": "reverse direction: the host (a member) edits the client's shop; the host relays to the owner (client)"
    },
    {
      "seq": 21,
      "role": "h",
      "sleep_s": 3
    },
    {
      "seq": 22,
      "role": "c",
      "cmd": "prices ${clientShop}",
      "expect_result": "\\| ${clientProduct}=${newPrice2}( |$)"
    },
    {
      "seq": 23,
      "role": "h",
      "cmd": "prices ${clientShop}",
      "expect_result": "\\| ${clientProduct}=${newPrice2}( |$)"
    },
    {
      "seq": 24,
      "role": "h",
      "cmd": "setprice ${hostShop} ${hostProduct} ${newPrice2}",
      "expect_result": "^OK setprice addr='${hostShop}' product='${hostProduct}' value=${newPrice2} routed=False",
      "note": "the owner's own edit is local, not routed"
    },
    {
      "seq": 25,
      "role": "h",
      "sleep_s": 3
    },
    {
      "seq": 26,
      "role": "c",
      "cmd": "prices ${hostShop}",
      "expect_result": "\\| ${hostProduct}=${newPrice2}( |$)",
      "note": "the owner's own change reaches the member through the publish"
    },
    {
      "seq": 27,
      "role": "c",
      "cmd": "merge leave",
      "expect_result": "OK merge leave sent",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[BAMP\\] \\[Merger\\] '${clientPid}' left their merger group",
          "within_s": 20
        }
      ]
    },
    {
      "seq": 28,
      "role": "h",
      "sleep_s": 3
    },
    {
      "seq": 29,
      "role": "h",
      "cmd": "prices ${hostShop}",
      "expect_result": "\\| ${hostProduct}=${newPrice2}( |$)",
      "note": "prices set during the merger stay (they were the owner's own writes)"
    },
    {
      "seq": 30,
      "role": "h",
      "cmd": "save",
      "expect_result": "^OK"
    },
    {
      "seq": 31,
      "role": "both",
      "cmd": "mark TEST P2-PRICES END",
      "expect_result": "OK MARK"
    }
  ]
}
  "vars": {
    "clientPid": "Client1",
    "hostPid": "melaus",
    "session": "fx-hq1",
    "keepMerger": true,
    "hostShop": "58 ba:street_fifthavenue",
    "nextShop": "60 ba:street_fifthavenue"
  },

{
  "id": "T-MERGERSERVICE",
  "title": "T-24 part 1, two players: a merged MEMBER books a FURNITURE and a FOOD delivery for a partner's shop; the booking is created ONLY on the game that runs the shop (once, even when resent), nothing is charged at booking, the goods arrive there when the slot passes; then, with the owner away, the STAND-IN books for the owner's shop and the booking goes home with the owner. Ends dissolved, NO save",
  "preconditions": "Fixture save1 (host melaus, client Client1). Build with T-24 part 1 deployed on BOTH machines. HOST = OWNER for legs 1-3 (the client's mergestatus keys[0] is a host building flipped on the client); CLIENT = OWNER for leg 5 (the host's mergestatus keys[0], which the host simulates while the client is away). Steps 13-22 check every premise and refuse on a pre-existing delivery for either shop. The rig draws no dialog: `mergerfurniture` / `mergerfood` send the leg the dialogs send, `servicelists` reads both lists with an own/stand-in tag, `pickercheck` runs the destination picker's filter. The leg 'owner offline and nobody standing in' has NO fixture here: a dropped owner always gets the host as stand-in. NOTHING is saved.",
  "instances": 2,
  "vars": {
    "clientPid": "Client1",
    "hostPid": "melaus",
    "session": "save1"
  },
  "oracles_absent": [
    "NullReferenceException",
    "HarmonyException",
    "Patching exception",
    "booking REFUSED",
    "routed booking for .* was refused",
    "\\[Merger\\] accept .* REFUSED"
  ],
  "oracles_report": [
    "delivery booking applied for",
    "already routed - dropped",
    "applied on its sender",
    "tagged to the absent owner",
    "\\[Absence\\] return to"
  ],
  "steps": [
    { "seq": 1, "role": "h", "cmd": "host", "expect_result": "^OK" },
    { "seq": 2, "role": "c", "cmd": "join", "expect_result": "^OK" },
    { "seq": 3, "role": "h", "cmd": "hostload ${session}", "expect_result": "^OK" },
    { "seq": 4, "role": "both", "cmd": "mark TEST MERGERSERVICE START", "expect_result": "OK MARK" },
    { "seq": 5, "role": "h", "cmd": "merge propose ${clientPid}", "expect_result": "OK merge propose sent" },
    { "seq": 6, "role": "h", "sleep_s": 1 },
    { "seq": 7, "role": "h", "cmd": "offers", "expect_result": "pending=\\[${clientPid}<-${hostPid}\\]" },
    { "seq": 8, "role": "c", "cmd": "merge accept", "expect_result": "OK merge accept sent" },
    { "seq": 9, "role": "h", "sleep_s": 3 },
    { "seq": 10, "role": "h", "cmd": "mergestatus", "expect_result": "member=True.*flipped=[1-9]", "capture": { "clientShop": "keys=\\['([^']+)'" }, "note": "on the HOST the flipped keys are the CLIENT's buildings: the leg-5 shop" },
    { "seq": 11, "role": "c", "sleep_s": 30, "note": "the worlds settle and the first paperwork bundles cross" },
    { "seq": 12, "role": "c", "cmd": "status", "expect_result": "settled=True" },
    { "seq": 13, "role": "c", "cmd": "mergestatus", "expect_result": "member=True.*flipped=[1-9]", "capture": { "ownerShop": "keys=\\['([^']+)'" }, "note": "PREMISE: on the CLIENT keys[0] is a HOST building flipped here (MergerFlip.IsFlipped) - the legs 1-3 shop" },
    { "seq": 14, "role": "h", "cmd": "mergestatus", "expect_result": "member=True", "refute_result": "'${ownerShop}'", "note": "PREMISE: the same building is NOT flipped on the host - with step 15 (rented there) that is MergerFlip.TrulyMine" },
    { "seq": 15, "role": "h", "cmd": "pickercheck furniture ${ownerShop}", "expect_result": "^OK pickercheck furniture key='${ownerShop}' listed=True offered=True" },
    { "seq": 16, "role": "c", "cmd": "pickercheck furniture ${ownerShop}", "expect_result": "^OK pickercheck furniture key='${ownerShop}' listed=True offered=True", "note": "THE PICKER: a partner shop whose owner is in the session is offered to the member (it used to be removed)" },
    { "seq": 17, "role": "c", "cmd": "pickercheck food ${ownerShop}", "expect_result": "listed=True offered=True" },
    { "seq": 18, "role": "h", "cmd": "servicelists ${ownerShop}", "expect_result": "^OK servicelists .* furniture=0 \\[\\] food=0 \\[\\]", "note": "PREMISE: no delivery booked for that shop on the owner before the run" },
    { "seq": 19, "role": "c", "cmd": "servicelists ${ownerShop}", "expect_result": "^OK servicelists .* furniture=0 \\[\\] food=0 \\[\\]" },
    { "seq": 20, "role": "c", "cmd": "servicelists ${clientShop}", "expect_result": "^OK servicelists .* furniture=0 \\[\\] food=0 \\[\\]", "note": "PREMISE for leg 5" },
    { "seq": 21, "role": "c", "cmd": "servicelists stores ${ownerShop}", "expect_result": "^OK servicelists stores=[1-9]\\d* \\[", "capture": { "store": "stores=\\d+ \\[([^|]+)\\|" } },
    { "seq": 22, "role": "h", "cmd": "servicelists stores ${clientShop}", "expect_result": "^OK servicelists stores=[1-9]\\d* \\[", "capture": { "store2": "stores=\\d+ \\[([^|]+)\\|" } },

    { "seq": 23, "role": "both", "cmd": "mark LEG1 FURNITURE", "expect_result": "OK MARK" },
    { "seq": 24, "role": "h", "cmd": "money", "expect_result": "^OK money=", "capture": { "hm0": "money=([-0-9.]+)" } },
    { "seq": 25, "role": "c", "cmd": "money", "expect_result": "^OK money=", "capture": { "cm0": "money=([-0-9.]+)" } },
    { "seq": 26, "role": "c", "cmd": "mergerfurniture ${ownerShop} ${store} auto min next -", "expect_result": "^OK mergerfurniture routed for '${ownerShop}'", "capture": { "fid": "id ([0-9a-f]+)\\)" },
      "expect_log": [ { "role": "h", "regex": "furniture delivery booking applied for '${ownerShop}' from '${clientPid}'", "within_s": 20 } ] },
    { "seq": 27, "role": "h", "sleep_s": 2 },
    { "seq": 28, "role": "h", "cmd": "servicelists ${ownerShop}", "expect_result": "furniture=1 \\[${ownerShop}\\|\\d+\\|\\d+\\|own\\|[^\\]]+\\] food=0", "note": "exactly ONE contract, on the OWNER, its own" },
    { "seq": 29, "role": "c", "cmd": "servicelists ${ownerShop}", "expect_result": "furniture=0 \\[\\] food=0 \\[\\]", "note": "NONE on the member" },
    { "seq": 30, "role": "h", "cmd": "money", "expect_result": "^OK money=${hm0} ", "note": "nothing charged at booking (the game charges on delivery)" },
    { "seq": 31, "role": "c", "cmd": "money", "expect_result": "^OK money=${cm0} " },
    { "seq": 32, "role": "c", "cmd": "mergerfurniture ${ownerShop} ${store} auto min next - ${fid}", "expect_result": "^OK mergerfurniture routed",
      "expect_log": [ { "role": "h", "regex": "mergerfurniture booking ${fid} from '${clientPid}' already routed - dropped", "within_s": 20 } ], "note": "THE RESEND: same booking id" },
    { "seq": 33, "role": "h", "sleep_s": 2 },
    { "seq": 34, "role": "h", "cmd": "servicelists ${ownerShop}", "expect_result": "furniture=1 \\[", "note": "applied once" },

    { "seq": 35, "role": "both", "cmd": "mark LEG2 FOOD", "expect_result": "OK MARK" },
    { "seq": 36, "role": "c", "cmd": "mergerfood ${ownerShop} auto min next -", "expect_result": "^OK mergerfood routed for '${ownerShop}'", "capture": { "did": "id ([0-9a-f]+)\\)" },
      "expect_log": [ { "role": "h", "regex": "food delivery booking applied for '${ownerShop}' from '${clientPid}'", "within_s": 20 } ] },
    { "seq": 37, "role": "h", "sleep_s": 2 },
    { "seq": 38, "role": "h", "cmd": "servicelists ${ownerShop}", "expect_result": "furniture=1 \\[.*\\] food=1 \\[${ownerShop}\\|\\d+\\|\\d+\\|own\\|" },
    { "seq": 39, "role": "c", "cmd": "servicelists ${ownerShop}", "expect_result": "furniture=0 \\[\\] food=0 \\[\\]" },
    { "seq": 40, "role": "h", "cmd": "money", "expect_result": "^OK money=${hm0} " },
    { "seq": 41, "role": "c", "cmd": "mergerfood ${ownerShop} auto min next - ${did}", "expect_result": "^OK mergerfood routed",
      "expect_log": [ { "role": "h", "regex": "mergerfood booking ${did} from '${clientPid}' already routed - dropped", "within_s": 20 } ] },
    { "seq": 42, "role": "h", "sleep_s": 2 },
    { "seq": 43, "role": "h", "cmd": "servicelists ${ownerShop}", "expect_result": "furniture=1 \\[.*\\] food=1 \\[" },

    { "seq": 44, "role": "both", "cmd": "mark LEG3 DELIVERY", "expect_result": "OK MARK" },
    { "seq": 45, "role": "h", "cmd": "clock 23:30", "expect_result": "^OK" },
    { "seq": 46, "role": "h", "cmd": "clock next", "expect_result": "^OK" },
    { "seq": 47, "role": "h", "cmd": "clock 10:30", "expect_result": "^OK", "note": "the furniture slot is today 10/14 or tomorrow 10; the food slot is within hours - both are now past on the OWNER's clock" },
    { "seq": 48, "role": "h", "sleep_s": 3 },
    { "seq": 49, "role": "h", "cmd": "servicelists ${ownerShop}", "expect_result": "furniture=0 \\[\\] food=0 \\[\\] spot=[1-9]", "note": "both deliveries left the list and the goods are in the delivery spot ON THE OWNER" },
    { "seq": 50, "role": "h", "cmd": "money", "expect_result": "^OK money=", "note": "report only: the charge is the game's own PayDelivery, but the midnight pass moves money too" },
    { "seq": 51, "role": "c", "cmd": "servicelists ${ownerShop}", "expect_result": "furniture=0 \\[\\] food=0 \\[\\]" },

    { "seq": 52, "role": "both", "cmd": "mark LEG5 STAND-IN", "expect_result": "OK MARK" },
    { "seq": 53, "role": "c", "drop": true, "note": "the client - owner of clientShop - drops; the host stands in",
      "expect_log": [ { "role": "h", "regex": "\\[Absence\\] simulating '${clientShop}' for '${clientPid}'", "within_s": 90 } ] },
    { "seq": 54, "role": "h", "cmd": "pickercheck furniture ${clientShop}", "expect_result": "listed=True offered=True", "note": "the stand-in is offered the away owner's shop" },
    { "seq": 55, "role": "h", "cmd": "mergerfurniture ${clientShop} ${store2} auto min 1 10", "expect_result": "^OK mergerfurniture routed for '${clientShop}'",
      "expect_log": [ { "role": "h", "regex": "mergerfurniture for '${clientShop}' applied on its sender '${hostPid}'", "within_s": 20 },
                      { "role": "h", "regex": "furniture delivery booking for '${clientShop}' tagged to the absent owner", "within_s": 20 },
                      { "role": "h", "regex": "furniture delivery booking applied for '${clientShop}' from '${hostPid}'", "within_s": 20 } ] },
    { "seq": 56, "role": "h", "sleep_s": 2 },
    { "seq": 57, "role": "h", "cmd": "servicelists ${clientShop}", "expect_result": "furniture=1 \\[${clientShop}\\|\\d+\\|10\\|standin:[^|]+\\|" },
    { "seq": 58, "role": "c", "relaunch": true, "note": "the absent owner returns" },
    { "seq": 59, "role": "c", "cmd": "join", "expect_result": "^OK" },
    { "seq": 60, "role": "h", "cmd": "acceptjoin", "expect_result": "^OK",
      "expect_log": [ { "role": "h", "regex": "\\[Absence\\] owner '${clientPid}' returned", "within_s": 120 },
                      { "role": "h", "regex": "\\[Absence\\] return to '${clientPid}'", "within_s": 150 } ] },
    { "seq": 61, "role": "c", "sleep_s": 20 },
    { "seq": 62, "role": "c", "cmd": "servicelists ${clientShop}", "expect_result": "furniture=1 \\[${clientShop}\\|\\d+\\|10\\|own\\|", "note": "the booking is in the OWNER's list, as its own - exactly one" },
    { "seq": 63, "role": "h", "cmd": "servicelists ${clientShop}", "expect_result": "furniture=0 \\[\\]", "note": "and gone from the stand-in" },

    { "seq": 64, "role": "both", "cmd": "mark LEG6 WAREHOUSE", "expect_result": "OK MARK", "note": "F2 + F7: a booking for a partner WAREHOUSE (the host's, flipped on the client) - the host's work-tab address gate used to drop it; the applied line carries the ABSOLUTE slot day" },
    { "seq": 65, "role": "c", "cmd": "warehouses", "expect_result": "flipped=\\['[^']+'", "capture": { "wh": "flipped=\\['([^']+)'" }, "note": "PREMISE: a host warehouse flipped on the client (save1: the host owns warehouses)" },
    { "seq": 66, "role": "c", "cmd": "pickercheck furniture ${wh}", "expect_result": "^OK pickercheck furniture key='${wh}' listed=True offered=True", "note": "the game's picker lists the warehouse and the member is offered it" },
    { "seq": 67, "role": "h", "cmd": "servicelists ${wh}", "expect_result": "^OK servicelists .* furniture=0 \\[\\]", "note": "PREMISE: no furniture delivery booked for it on the owner" },
    { "seq": 68, "role": "c", "cmd": "servicelists stores ${wh}", "expect_result": "^OK servicelists stores=[1-9]\\d* \\[", "capture": { "store3": "stores=\\d+ \\[([^|]+)\\|" }, "note": "a store that delivers to a warehouse" },
    { "seq": 69, "role": "c", "cmd": "mergerfurniture ${wh} ${store3} auto min next -", "expect_result": "^OK mergerfurniture routed for '${wh}'",
      "expect_log": [ { "role": "h", "regex": "furniture delivery booking applied for '${wh}' from '${clientPid}' \\(booking [0-9a-f]+, \\d+ item\\(s\\), slot day \\d+ \\d+h", "within_s": 20 } ],
      "note": "before the fold: dropped at the host ('excluded ... dropped') and no 'slot day' in the applied line" },
    { "seq": 70, "role": "h", "sleep_s": 2 },
    { "seq": 71, "role": "h", "cmd": "servicelists ${wh}", "expect_result": "furniture=1 \\[${wh}\\|\\d+\\|\\d+\\|own\\|", "note": "exactly one, on the OWNER" },
    { "seq": 72, "role": "c", "cmd": "servicelists ${wh}", "expect_result": "furniture=0 \\[\\]", "note": "none on the member" },

    { "seq": 73, "role": "c", "cmd": "merge leave", "expect_result": "OK merge leave sent", "note": "FIXTURE HYGIENE: end dissolved; NO save" },
    { "seq": 74, "role": "h", "sleep_s": 5 },
    { "seq": 75, "role": "h", "cmd": "mergestatus", "expect_result": "member=False.*flipped=0" },
    { "seq": 76, "role": "both", "cmd": "mark TEST MERGERSERVICE END", "expect_result": "OK MARK" }
  ]
}

{
  "id": "T-P2-WAVE3-ABS",
  "title": "phase-2 wave 3, three players: with the owner (Client1) dropped and the host simulating its shops, a work edit from Client2 routes to the HOST (the stand-in) and is applied there; the owner returns; ends dissolved",
  "preconditions": "Fixture save1 plus the third instance (role d, PlayerId Client2, charconfirm armed). Build with wave 3 deployed. Scenario ends dissolved.",
  "instances": 3,
  "vars": {
    "clientPid": "Client1",
    "hostPid": "melaus",
    "dPid": "Client2",
    "session": "save1",
    "newPrice": "12.34"
  },
  "oracles_absent": [
    "NullReferenceException",
    "HarmonyException",
    "Patching exception",
    "\\[Merger\\] route for .* refused",
    "\\[Merger\\] accept .* REFUSED",
    "upload SKIPPED"
  ],
  "oracles_report": [
    "\\[Merger\\] work edit",
    "\\[Absence\\]",
    "\\[Paperwork\\]"
  ],
  "steps": [
    {
      "seq": 1,
      "role": "h",
      "cmd": "host",
      "expect_result": "^OK"
    },
    {
      "seq": 2,
      "role": "c",
      "cmd": "join",
      "expect_result": "^OK"
    },
    {
      "seq": 3,
      "role": "d",
      "cmd": "join",
      "expect_result": "^OK"
    },
    {
      "seq": 4,
      "role": "d",
      "cmd": "charconfirm",
      "expect_result": "^OK armed"
    },
    {
      "seq": 5,
      "role": "h",
      "cmd": "hostload ${session}",
      "expect_result": "^OK"
    },
    {
      "seq": 6,
      "role": "all",
      "cmd": "mark TEST P2-WAVE3-ABS START",
      "expect_result": "OK MARK"
    },
    {
      "seq": 7,
      "role": "h",
      "cmd": "merge propose ${clientPid}",
      "expect_result": "OK merge propose sent"
    },
    {
      "seq": 8,
      "role": "h",
      "sleep_s": 1
    },
    {
      "seq": 9,
      "role": "h",
      "cmd": "offers",
      "expect_result": "pending=\\[${clientPid}<-${hostPid}\\]"
    },
    {
      "seq": 10,
      "role": "c",
      "cmd": "merge accept",
      "expect_result": "OK merge accept sent"
    },
    {
      "seq": 11,
      "role": "h",
      "sleep_s": 3
    },
    {
      "seq": 12,
      "role": "h",
      "cmd": "mergestatus",
      "expect_result": "member=True.*flipped=[1-9]",
      "capture": {
        "clientShop": "keys=\\['([^']+)'"
      }
    },
    {
      "seq": 13,
      "role": "h",
      "cmd": "merge propose ${dPid}",
      "expect_result": "OK merge propose sent"
    },
    {
      "seq": 14,
      "role": "h",
      "sleep_s": 1
    },
    {
      "seq": 15,
      "role": "d",
      "cmd": "merge accept",
      "expect_result": "OK merge accept sent"
    },
    {
      "seq": 16,
      "role": "h",
      "sleep_s": 3
    },
    {
      "seq": 17,
      "role": "d",
      "cmd": "mergestatus",
      "expect_result": "member=True.*flipped=[1-9]",
      "note": "three-member company; Client2 sees the others' buildings flipped"
    },
    {
      "seq": 18,
      "role": "h",
      "cmd": "mark pre-drop baseline",
      "expect_result": "OK MARK"
    },
    {
      "seq": 19,
      "role": "c",
      "drop": true,
      "note": "the business-owning member drops out; the host (a member) is the stand-in",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[Absence\\] simulating '${clientShop}' for '${clientPid}'",
          "within_s": 90
        }
      ]
    },
    {
      "seq": 20,
      "role": "h",
      "cmd": "mark client dropped",
      "expect_result": "OK MARK"
    },
    {
      "seq": 21,
      "role": "h",
      "cmd": "absence",
      "expect_result": "^OK absence marks=\\[${clientPid}->${hostPid}( ownerBack=\\d)?: .*\\] simulating_here=\\[.*${clientShop}"
    },
    {
      "seq": 22,
      "role": "d",
      "cmd": "prices ${clientShop}",
      "expect_result": "^OK prices addr='${clientShop}' n=[1-9]",
      "capture": {
        "clientProduct": "\\| ([^=|]+)="
      }
    },
    {
      "seq": 23,
      "role": "d",
      "cmd": "setprice ${clientShop} ${clientProduct} 12.34",
      "expect_result": "^OK setprice addr='${clientShop}' product='${clientProduct}' value=12.34 routed=True",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[Merger\\] price edit applied for '${clientShop}' from '${dPid}'",
          "within_s": 20
        }
      ],
      "note": "W3-0 + F1: the owner is offline, so the resolver sends the price edit to the stand-in (the host), which applies it on its lifted copy"
    },
    {
      "seq": 24,
      "role": "h",
      "sleep_s": 3
    },
    {
      "seq": 25,
      "role": "h",
      "cmd": "prices ${clientShop}",
      "expect_result": "\\| ${clientProduct}=12.34( |$)",
      "note": "the stand-in's copy carries the routed price"
    },
    {
      "seq": 26,
      "role": "c",
      "relaunch": true,
      "note": "the absent member returns"
    },
    {
      "seq": 27,
      "role": "c",
      "cmd": "join",
      "expect_result": "^OK"
    },
    {
      "seq": 28,
      "role": "h",
      "cmd": "acceptjoin",
      "expect_result": "^OK",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[Absence\\] owner '${clientPid}' returned",
          "within_s": 120
        },
        {
          "role": "h",
          "regex": "\\[Absence\\] return to '${clientPid}'",
          "within_s": 150
        }
      ]
    },
    {
      "seq": 29,
      "role": "h",
      "cmd": "absence",
      "expect_result": "returned=\\[.+\\]"
    },
    {
      "seq": 30,
      "role": "d",
      "cmd": "merge leave",
      "expect_result": "OK merge leave sent",
      "note": "FIXTURE HYGIENE: the newcomer leaves"
    },
    {
      "seq": 31,
      "role": "h",
      "sleep_s": 3
    },
    {
      "seq": 32,
      "role": "c",
      "cmd": "merge leave",
      "expect_result": "OK merge leave sent",
      "note": "the pair dissolves"
    },
    {
      "seq": 33,
      "role": "h",
      "sleep_s": 3
    },
    {
      "seq": 34,
      "role": "h",
      "cmd": "mergestatus",
      "expect_result": "member=False.*flipped=0"
    },
    {
      "seq": 35,
      "role": "h",
      "cmd": "save",
      "expect_result": "^OK"
    },
    {
      "seq": 36,
      "role": "all",
      "cmd": "mark TEST P2-WAVE3-ABS END",
      "expect_result": "OK MARK"
    }
  ]
}

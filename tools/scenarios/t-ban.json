{
  "id": "T-BAN",
  "title": "BAN-PLAYERS-1 build A (lasting ban): an in-lobby DEV ban of a connected client (tag bannedgame, approved text) is saved; its rejoin is refused with tag banned (approved text) in the lobby, after a re-host, and after a host process restart; unban -> joins; in game the merged member is banned (clean leave - no paused-until-rejoin, avatar removed, buildings held, absence stand-in starts); unban -> rejoins. The rig's 127.0.0.1 is never recorded as an address (refusals match by stable id).",
  "preconditions": "Dev build with the 'ban'/'unban' levers. Fixture save1 (host melaus, client Client1). Uses the driver's drop/relaunch steps for the host. The host's saved ban list is emptied at the start and must be empty at the end (the last 'ban list'); fixture_reset re-prepares the save the disconnect save touches. Steam joins cannot be exercised on the one-account rig.",
  "instances": 2,
  "vars": {
    "clientPid": "Client1",
    "hostPid": "melaus",
    "session": "save1"
  },
  "oracles_absent": [
    "NullReferenceException",
    "game paused until they rejoin",
    "\\[Server\\] Paused session",
    "\\[Server\\] connection request from \\d",
    "\\[Server\\] saved-ban (check|address note):",
    "\\[Server\\] (BanPlayer|BanOfflinePlayer|UnbanPlayer)\\(",
    "\\[Config\\] (AddBan|NoteBannedAddress|RemoveBan|BannedPlayers (load|save)):",
    "ips=[1-9]"
  ],
  "oracles_report": [
    "\\[Server\\] (BANNED|UNBANNED|Hello from BANNED)",
    "\\[Config\\] Saved bans",
    "disconnect reason tag",
    "Holding \\d+ building",
    "\\[Server\\] connection request from",
    "\\[RemotePlayer\\] Removed",
    "\\[Absence\\]",
    "left cleanly",
    "\\[TestDrive\\] ledger"
  ],
  "steps": [
    {
      "role": "all",
      "cmd": "mark TEST BAN START",
      "expect_result": "OK MARK",
      "seq": 1
    },
    {
      "role": "h",
      "cmd": "unban all",
      "expect_result": "^OK unbanned \\d+ left=0",
      "note": "hygiene: no saved ban left from an aborted run",
      "seq": 2
    },
    {
      "role": "h",
      "cmd": "host",
      "expect_result": "^OK",
      "seq": 3
    },
    {
      "role": "c",
      "cmd": "join",
      "expect_result": "^OK",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[Server\\] '${clientPid}' joined lobby\\.",
          "within_s": 60
        }
      ],
      "seq": 4
    },
    {
      "role": "h",
      "sleep_s": 3,
      "seq": 5
    },
    {
      "role": "h",
      "cmd": "ban ${clientPid}",
      "note": "(1) the DEV in-lobby Ban of a connected client; (6) the rig's 127.0.0.1 is NOT recorded",
      "expect_result": "^OK banned '${clientPid}' key=(\\S+) stable=yes steam=no ip=not-recorded \\(addr:loopback#[0-9a-f]{6}\\)",
      "capture": {
        "banKey": "key=(\\S+)"
      },
      "expect_log": [
        {
          "role": "c",
          "regex": "\\[Client\\] disconnect reason tag: 'BAMP:bannedgame' . \"You were banned by the host\\.",
          "within_s": 30
        },
        {
          "role": "h",
          "regex": "\\[Server\\] BANNED '${clientPid}' \\(saved ban ${banKey}: stable id yes, Steam id no, address not recorded addr:loopback#[0-9a-f]{6}\\) - lasts until unbanned\\.",
          "within_s": 10
        }
      ],
      "seq": 6
    },
    {
      "role": "h",
      "cmd": "ban list",
      "expect_result": "^OK ban list n=1 \\[${banKey} '${clientPid}' stable=\\S+ steam=no ips=0 day=\\d+ since=\\d{4}-\\d{2}-\\d{2}\\]",
      "note": "(6) the saved entry holds no address (loopback never recorded) - the refusals below match by stable id",
      "seq": 7
    },
    {
      "role": "c",
      "sleep_s": 5,
      "seq": 8
    },
    {
      "role": "all",
      "cmd": "mark TEST BAN LOBBY-REFUSE",
      "expect_result": "OK MARK",
      "seq": 9
    },
    {
      "role": "c",
      "cmd": "join",
      "expect_result": "^OK",
      "note": "LOBBY-REFUSE: the banned client's join is refused at Hello with 'BAMP:banned'",
      "expect_log": [
        {
          "role": "c",
          "regex": "\\[Client\\] disconnect reason tag: 'BAMP:banned' . \"You're banned from this host's games\\.",
          "within_s": 60
        },
        {
          "role": "h",
          "regex": "\\[Server\\] Hello from BANNED '${clientPid}' \\(saved ban b[0-9a-f]{7}, matched by stable id; from addr:loopback#[0-9a-f]{6}\\) . disconnected\\.",
          "within_s": 60
        }
      ],
      "seq": 10
    },
    {
      "role": "c",
      "sleep_s": 5,
      "seq": 11
    },
    {
      "role": "h",
      "cmd": "uiview leave",
      "expect_result": "^OK uiview leave: left server=False",
      "seq": 12
    },
    {
      "role": "h",
      "sleep_s": 3,
      "seq": 13
    },
    {
      "role": "h",
      "cmd": "host",
      "expect_result": "^OK server started",
      "seq": 14
    },
    {
      "role": "all",
      "cmd": "mark TEST BAN REHOST-REFUSE",
      "expect_result": "OK MARK",
      "seq": 15
    },
    {
      "role": "c",
      "cmd": "join",
      "expect_result": "^OK",
      "note": "REHOST-REFUSE: the banned client's join is refused at Hello with 'BAMP:banned'",
      "expect_log": [
        {
          "role": "c",
          "regex": "\\[Client\\] disconnect reason tag: 'BAMP:banned' . \"You're banned from this host's games\\.",
          "within_s": 60
        },
        {
          "role": "h",
          "regex": "\\[Server\\] Hello from BANNED '${clientPid}' \\(saved ban b[0-9a-f]{7}, matched by stable id; from addr:loopback#[0-9a-f]{6}\\) . disconnected\\.",
          "within_s": 60
        }
      ],
      "seq": 16
    },
    {
      "role": "c",
      "sleep_s": 5,
      "seq": 17
    },
    {
      "role": "h",
      "cmd": "uiview leave",
      "expect_result": "^OK uiview leave: left server=False",
      "seq": 18
    },
    {
      "role": "h",
      "sleep_s": 3,
      "seq": 19
    },
    {
      "role": "h",
      "drop": true,
      "seq": 20
    },
    {
      "role": "h",
      "relaunch": true,
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[Config\\] Saved bans: 1\\.",
          "within_s": 120
        }
      ],
      "seq": 21
    },
    {
      "role": "h",
      "sleep_s": 20,
      "seq": 22
    },
    {
      "role": "h",
      "cmd": "ban list",
      "expect_result": "^OK ban list n=1 \\[${banKey} '${clientPid}' ",
      "seq": 23
    },
    {
      "role": "h",
      "cmd": "host",
      "expect_result": "^OK server started",
      "seq": 24
    },
    {
      "role": "all",
      "cmd": "mark TEST BAN RESTART-REFUSE",
      "expect_result": "OK MARK",
      "seq": 25
    },
    {
      "role": "c",
      "cmd": "join",
      "expect_result": "^OK",
      "note": "RESTART-REFUSE: the banned client's join is refused at Hello with 'BAMP:banned'",
      "expect_log": [
        {
          "role": "c",
          "regex": "\\[Client\\] disconnect reason tag: 'BAMP:banned' . \"You're banned from this host's games\\.",
          "within_s": 60
        },
        {
          "role": "h",
          "regex": "\\[Server\\] Hello from BANNED '${clientPid}' \\(saved ban b[0-9a-f]{7}, matched by stable id; from addr:loopback#[0-9a-f]{6}\\) . disconnected\\.",
          "within_s": 60
        }
      ],
      "seq": 26
    },
    {
      "role": "c",
      "sleep_s": 5,
      "seq": 27
    },
    {
      "role": "h",
      "cmd": "unban ${banKey}",
      "expect_result": "^OK unbanned 1 left=0",
      "seq": 28
    },
    {
      "role": "all",
      "cmd": "mark TEST BAN UNBAN1",
      "expect_result": "OK MARK",
      "seq": 29
    },
    {
      "role": "c",
      "cmd": "join",
      "expect_result": "^OK",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[Server\\] '${clientPid}' joined lobby\\.",
          "within_s": 60
        }
      ],
      "seq": 30
    },
    {
      "role": "h",
      "sleep_s": 3,
      "seq": 31
    },
    {
      "role": "h",
      "cmd": "hostload ${session}",
      "expect_result": "^OK",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[BAMP\\] \\[LoadProf\\].*HOST ReleaseStartupHold \\(all players world-ready\\)",
          "within_s": 300
        },
        {
          "role": "h",
          "regex": "\\[BAMP\\] \\[Lifecycle\\] WorldReady",
          "within_s": 60
        }
      ],
      "seq": 32
    },
    {
      "role": "h",
      "cmd": "merge propose ${clientPid}",
      "expect_result": "OK merge propose sent",
      "seq": 33
    },
    {
      "role": "h",
      "sleep_s": 1,
      "seq": 34
    },
    {
      "role": "h",
      "cmd": "offers",
      "expect_result": "pending=\\[${clientPid}<-${hostPid}\\]",
      "seq": 35
    },
    {
      "role": "c",
      "cmd": "merge accept",
      "expect_result": "OK merge accept sent",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[BAMP\\] \\[Merger\\] FORMED group",
          "within_s": 20
        }
      ],
      "seq": 36
    },
    {
      "role": "h",
      "sleep_s": 3,
      "seq": 37
    },
    {
      "role": "h",
      "cmd": "mergestatus",
      "expect_result": "member=True.*flipped=[1-9]",
      "capture": {
        "clientShop": "keys=\\['([^']+)'"
      },
      "seq": 38
    },
    {
      "role": "h",
      "cmd": "absence",
      "expect_result": "^OK absence marks=\\[\\] simulating_here=\\[\\]",
      "seq": 39
    },
    {
      "role": "all",
      "cmd": "mark TEST BAN INGAME",
      "expect_result": "OK MARK",
      "seq": 40
    },
    {
      "role": "h",
      "cmd": "ban ${clientPid}",
      "expect_result": "^OK banned '${clientPid}' key=(\\S+) stable=yes steam=no ip=not-recorded",
      "capture": {
        "banKey2": "key=(\\S+)"
      },
      "note": "(4) tag bannedgame + approved text; clean leave (no pause); avatar removed; (7) the absence path starts",
      "expect_log": [
        {
          "role": "c",
          "regex": "\\[Client\\] disconnect reason tag: 'BAMP:bannedgame' . \"You were banned by the host\\.",
          "within_s": 30
        },
        {
          "role": "h",
          "regex": "\\[Server\\] Peer disconnected: \\d+ . BannedByHost",
          "within_s": 10
        },
        {
          "role": "h",
          "regex": "\\[Server\\] '${clientPid}' left cleanly . game continues\\.",
          "within_s": 10
        },
        {
          "role": "h",
          "regex": "\\[RemotePlayer\\] Removed '${clientPid}'",
          "within_s": 20
        },
        {
          "role": "h",
          "regex": "\\[Absence\\] simulating '${clientShop}' for '${clientPid}'",
          "within_s": 90
        },
        {
          "role": "h",
          "regex": "\\[Absence\\] stand-in start '${clientShop}' for '${clientPid}'",
          "within_s": 90
        }
      ],
      "seq": 41
    },
    {
      "role": "h",
      "sleep_s": 5,
      "seq": 42
    },
    {
      "role": "h",
      "cmd": "absence",
      "expect_result": "^OK absence marks=\\[${clientPid}->${hostPid}.*${clientShop}",
      "seq": 43
    },
    {
      "role": "h",
      "cmd": "mergestatus",
      "expect_result": "member=True.*flipped=[1-9]",
      "note": "the banned member stays a member; its buildings stay held/flipped",
      "seq": 44
    },
    {
      "role": "h",
      "cmd": "ledgerdump",
      "expect_result": "^OK \\d+ ledger",
      "seq": 45
    },
    {
      "role": "h",
      "cmd": "unban ${banKey2}",
      "expect_result": "^OK unbanned 1 left=0",
      "seq": 46
    },
    {
      "role": "c",
      "drop": true,
      "note": "the banned client is left in its own world, disconnected ('leavegame' needs a live connection) - restart it, as T-P3-2 does",
      "seq": 47
    },
    {
      "role": "c",
      "relaunch": true,
      "seq": 48
    },
    {
      "role": "c",
      "sleep_s": 20,
      "seq": 49
    },
    {
      "role": "all",
      "cmd": "mark TEST BAN REJOIN",
      "expect_result": "OK MARK",
      "seq": 50
    },
    {
      "role": "c",
      "cmd": "join",
      "expect_result": "^OK",
      "expect_log": [
        {
          "role": "h",
          "regex": "(returning player '${clientPid}' auto-accepted|host ACCEPTED mid-game join: '${clientPid}')",
          "within_s": 60
        }
      ],
      "seq": 51
    },
    {
      "role": "h",
      "sleep_s": 5,
      "seq": 52
    },
    {
      "role": "h",
      "cmd": "acceptjoin",
      "expect_result": "^OK",
      "seq": 53
    },
    {
      "role": "c",
      "sleep_s": 60,
      "seq": 54
    },
    {
      "role": "h",
      "cmd": "ban list",
      "expect_result": "^OK ban list n=0 ",
      "seq": 55
    },
    {
      "role": "all",
      "cmd": "mark TEST BAN END",
      "expect_result": "OK MARK",
      "seq": 56
    }
  ]
}

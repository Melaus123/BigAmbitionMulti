{
  "id": "T-P3-3",
  "title": "phase-3 absence, three players: the host is NOT a member; two clients merge, one drops, the host hands its businesses to the other client, which simulates them; the absent one returns",
  "preconditions": "Fixture save1 (host melaus/Prabaha, client Client1/REX) plus the third instance (role d, PlayerId Client2, joins as a NEW player - charconfirm armed before hostload). Dev build with P3-A/P3-B and the paperwork/absence verbs. Uses the driver's drop/relaunch steps. Log strings per brief-p3b-handover.md - re-check against the builder's report. The newcomer has no businesses of its own, so the company's only buildings are Client1's: Client2 becomes the simulator by the longest-online rule (the host is not a member). Ends dissolved (fixture hygiene).",
  "instances": 3,
  "vars": {
    "clientPid": "Client1",
    "hostPid": "melaus",
    "dPid": "Client2",
    "session": "save1"
  },
  "oracles_absent": [
    "NullReferenceException",
    "\\[Merger\\] accept .* REFUSED",
    "upload SKIPPED",
    "\\[Paperwork\\] .* refused"
  ],
  "oracles_report": [
    "\\[Paperwork\\]",
    "\\[Absence\\]",
    "\\[EconProbe\\] wallet"
  ],
  "steps": [
    {
      "seq": 1,
      "role": "h",
      "cmd": "host",
      "expect_result": "^OK"
    },
    {
      "seq": 2,
      "role": "c",
      "cmd": "join",
      "expect_result": "^OK"
    },
    {
      "seq": 3,
      "role": "d",
      "cmd": "join",
      "expect_result": "^OK"
    },
    {
      "seq": 4,
      "role": "d",
      "cmd": "charconfirm",
      "expect_result": "^OK armed"
    },
    {
      "seq": 5,
      "role": "h",
      "cmd": "hostload ${session}",
      "expect_result": "^OK",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[BAMP\\] \\[LoadProf\\].*HOST ReleaseStartupHold \\(all players world-ready\\)",
          "within_s": 300
        },
        {
          "role": "h",
          "regex": "\\[BAMP\\] \\[Lifecycle\\] WorldReady",
          "within_s": 60
        }
      ]
    },
    {
      "seq": 6,
      "role": "all",
      "cmd": "mark TEST P3-3 START",
      "expect_result": "OK MARK"
    },
    {
      "seq": 7,
      "role": "c",
      "cmd": "merge propose ${dPid}",
      "expect_result": "OK merge propose sent"
    },
    {
      "seq": 8,
      "role": "h",
      "sleep_s": 1
    },
    {
      "seq": 9,
      "role": "h",
      "cmd": "offers",
      "expect_result": "pending=\\[${dPid}<-${clientPid}\\]"
    },
    {
      "seq": 10,
      "role": "d",
      "cmd": "merge accept",
      "expect_result": "OK merge accept sent",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[BAMP\\] \\[Merger\\] FORMED group",
          "within_s": 20
        }
      ]
    },
    {
      "seq": 11,
      "role": "h",
      "sleep_s": 3
    },
    {
      "seq": 12,
      "role": "d",
      "cmd": "mergestatus",
      "expect_result": "member=True.*flipped=[1-9]",
      "capture": {
        "clientShop": "keys=\\['([^']+)'"
      },
      "note": "the newcomer sees Client1's buildings flipped"
    },
    {
      "seq": 13,
      "role": "h",
      "cmd": "mergestatus",
      "expect_result": "member=False",
      "note": "the host is NOT in the company"
    },
    {
      "seq": 14,
      "role": "c",
      "cmd": "paperwork push",
      "expect_result": "^OK paperwork pushed day=\\d+ businesses=[1-9]",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[Paperwork\\] stored for '${clientPid}'",
          "within_s": 15
        }
      ]
    },
    {
      "seq": 15,
      "role": "d",
      "cmd": "paperwork push",
      "expect_result": "^OK paperwork pushed day=\\d+ businesses=0",
      "note": "the newcomer owns nothing yet"
    },
    {
      "seq": 16,
      "role": "h",
      "cmd": "mark pre-drop baseline",
      "expect_result": "OK MARK",
      "note": "sets the host's search baseline before the disconnect"
    },
    {
      "seq": 17,
      "role": "c",
      "drop": true,
      "note": "the business-owning member drops out",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[Absence\\] hand-over of '${clientPid}' \\(\\d+ addresses, \\d+ bytes paperwork\\) -> '${dPid}'",
          "within_s": 90
        },
        {
          "role": "d",
          "regex": "\\[Absence\\] simulating '${clientShop}' for '${clientPid}'",
          "within_s": 90
        }
      ]
    },
    {
      "seq": 18,
      "role": "h",
      "cmd": "mark client dropped",
      "expect_result": "OK MARK",
      "note": "the host designates the other client and sends the hand-over; the simulator applies it (the take-over evidence is asserted on the drop step itself: it fires in the same second as the disconnect)"
    },
    {
      "seq": 19,
      "role": "d",
      "cmd": "absence",
      "expect_result": "^OK absence marks=\\[${clientPid}->${dPid}: .*\\] simulating_here=\\[.*${clientShop}"
    },
    {
      "seq": 20,
      "role": "h",
      "cmd": "absence",
      "expect_result": "^OK absence marks=\\[${clientPid}->${dPid}( ownerBack=\\d)?: .*\\] simulating_here=\\[\\]",
      "note": "the host tracks the mark but simulates nothing itself"
    },
    {
      "seq": 21,
      "role": "h",
      "sleep_s": 20
    },
    {
      "seq": 22,
      "role": "d",
      "cmd": "paperwork push",
      "expect_result": "^OK paperwork pushed day=\\d+ businesses=[1-9]",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[Paperwork\\] stored for '${dPid}'",
          "within_s": 15
        }
      ],
      "note": "the simulator now publishes the absent member's businesses under its own bundle"
    },
    {
      "seq": 23,
      "role": "c",
      "relaunch": true,
      "note": "the absent member returns"
    },
    {
      "seq": 24,
      "role": "c",
      "cmd": "join",
      "expect_result": "^OK"
    },
    {
      "seq": 25,
      "role": "h",
      "cmd": "acceptjoin",
      "expect_result": "^OK",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[Absence\\] owner '${clientPid}' returned",
          "within_s": 120
        },
        {
          "role": "h",
          "regex": "\\[Absence\\] return to '${clientPid}'",
          "within_s": 150
        }
      ],
      "note": "P3-B: the host detects the owner's return (simulator dropped, mark kept). P3-C: the return leg fires at the owner's applying edge (after its own load) - paperwork + interiors sent, mark cleared."
    },
    {
      "seq": 26,
      "role": "h",
      "cmd": "absence",
      "expect_result": "returned=\\[.+\\]",
      "expect_log": [
        {
          "role": "c",
          "regex": "\\[Absence\\] return applied: \\d+ address",
          "within_s": 90
        },
        {
          "role": "c",
          "regex": "\\[Absence\\] replaced my '",
          "within_s": 90
        },
        {
          "role": "c",
          "regex": "\\[Absence\\] return toast shown to '${clientPid}'",
          "within_s": 90
        }
      ],
      "note": "P3-C: the host's verb shows the last return; the owner applied it, replaced its stale copies (round-178 exception) and saw the approved toast (D17). Client lines are scanned from the client's last mark (its join)."
    },
    {
      "seq": 27,
      "role": "c",
      "cmd": "absence",
      "expect_result": "replaced=\\[.+\\]",
      "note": "P3-C: the owner's verb lists the addresses the return replaced here"
    },
    {
      "seq": 28,
      "role": "c",
      "cmd": "paperwork push",
      "expect_result": "^OK paperwork pushed",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[Paperwork\\] stored for '${clientPid}'",
          "within_s": 20
        }
      ],
      "note": "P3-C: with the mark cleared the owner's own publish stores normally (no OwnerBack guard)"
    },
    {
      "seq": 29,
      "role": "c",
      "cmd": "mergestatus",
      "expect_result": "member=True"
    },
    {
      "seq": 30,
      "role": "c",
      "cmd": "merge leave",
      "expect_result": "OK merge leave sent",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[BAMP\\] \\[Merger\\] '${clientPid}' left their merger group",
          "within_s": 20
        }
      ],
      "note": "FIXTURE HYGIENE: end with the company dissolved so the save step never writes a merger into save1's manifest (T-P3-3 run 1 lesson)"
    },
    {
      "seq": 31,
      "role": "d",
      "cmd": "merge leave",
      "expect_result": "OK merge leave sent",
      "note": "the newcomer leaves too (a pair dissolves on the first leave; this is a no-op if already dissolved)"
    },
    {
      "seq": 32,
      "role": "h",
      "sleep_s": 3
    },
    {
      "seq": 33,
      "role": "h",
      "cmd": "save",
      "expect_result": "^OK"
    },
    {
      "seq": 34,
      "role": "all",
      "cmd": "mark TEST P3-3 END",
      "expect_result": "OK MARK"
    }
  ]
}

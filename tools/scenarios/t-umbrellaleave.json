{
  "id": "T-UMBRELLALEAVE",
  "title": "UMBRELLA-LEAVE-1 + TIMESYNC-TEARDOWN-1: five client leaves to the menu in rain; the clock freezes for each city unload (as the plain game), no pedestrian umbrella wait throws mid-unload, no false huge catch-up, the client rejoins cleanly each time.",
  "preconditions": "Dev build with the 'rain', 'status', 'leavegame menu', 'acceptjoin' and 'pause' levers. Fixture save1 (host melaus, client Client1).",
  "instances": 2,
  "vars": {
    "clientPid": "Client1",
    "hostPid": "melaus",
    "session": "save1"
  },
  "oracles_absent": [
    "AddUmbrellaCoroutine",
    "TICK-ISO-1",
    "behind \\+[0-9]{3,}\\.[0-9]+ h",
    "HarmonyException",
    "Patching exception"
  ],
  "oracles_report": [
    "\\[Pause\\] clock frozen for the city unload",
    "\\[TimeSync\\] host clock ignored - no world loaded\\.",
    "forcing local to match",
    "Rain has not been initialized",
    "\\[TimeSync\\] JOIN SNAP: clock set"
  ],

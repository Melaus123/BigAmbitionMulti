   "note": "PREMISE: shoppers are still due today at this shop"
  },
  {
   "seq": 22,
   "role": "h",
   "cmd": "clock 09:59",
   "expect_result": "^OK clock",
   "note": "ALIGN every leg to the same minute; no hour is crossed by this jump"
  },
  {
   "seq": 23,
   "role": "h",
   "sleep_s": 3,

{
 "id": "T-WORKSKIP-B",
 "title": "WORKSKIP leg (b): solo host in his own STAFFED clothing store, one mod skip over hours 10 and 11.",
 "preconditions": "MEASUREMENT ONLY (bug 20260926-213955). Reporter fixture fx-hq1 (vars.keepMerger true, as every fx-hq1 scenario), SOLO: the client is dropped before the host hosts. Shop = the host's clothing store vars.shop. Part 1 predates the DEV `work` lever (see t-workskip-a2/b2/d2 for the working-player legs): the host STANDS in the shop and does not work the register. STAFFED: the fixture's schedule places an AI cashier. Same start in every leg: setup skip outdoors to 08:45, enter, `clock 09:59`, window opens hour 10 (asserted). NOTHING IS SAVED.",
 "instances": 2,
 "vars": {
  "clientPid": "Client1",
  "hostPid": "melaus",
  "session": "fx-hq1",
  "keepMerger": true,
  "shop": "20 ba:street_fifthavenue"
 },
 "oracles_absent": [
  "\\[TickIso\\]",
  "\\[Guard\\]",
  "(?<!swallowed )NullReferenceException"
 ],
 "oracles_report": [
  "\\[Rest\\] CONSENSUS",
  "\\[Rest\\] skip GOAL reached",
  "\\[Rest\\] occupied-shop",
  "\\[SkipPace\\] ",
  "SkipHandback|H-SKIPWALKIN",
  "TillDupes|H-SKIPDOUBLE",
  "\\[Customers\\] "
 ],
 "steps": [
  {
   "seq": 1,
   "role": "c",
   "drop": true,
   "note": "SOLO HOST: the client instance closes first and never joins"
  },
  {
   "seq": 2,
   "role": "h",
   "cmd": "host",
   "expect_result": "^OK"
  },
  {
   "seq": 3,
   "role": "h",
   "cmd": "hostload ${session}",
   "expect_result": "^OK"
  },
  {
   "seq": 4,
   "role": "h",
   "cmd": "mark TEST T-WORKSKIP-B START",
   "expect_result": "OK MARK"
  },
  {
   "seq": 5,
   "role": "h",
   "sleep_s": 32,
   "note": "the world settles"
  },
  {
   "seq": 6,
   "role": "h",
   "cmd": "status",
   "abort_on_fail": false,
   "note": "SOLO: MPWorldReady.IsSettled starts its 3 s settle clock on the FIRST read (run 1 of this scenario read settled=False here); report-only"
  },
  {
   "seq": 7,
   "role": "h",
   "sleep_s": 5
  },
  {
   "seq": 8,
   "role": "h",
   "cmd": "status",
   "expect_result": "settled=True"
  },
  {
   "seq": 9,
   "role": "h",
   "cmd": "pause off",
   "expect_result": "^OK"
  },
  {
   "seq": 10,
   "role": "h",
   "cmd": "exitbuilding",
   "abort_on_fail": false,
   "note": "report-only: an outdoor player only warns"
  },
  {
   "seq": 11,
   "role": "h",
   "sleep_s": 8
  },
  {
   "seq": 12,
   "role": "h",
   "cmd": "skiprate",
   "expect_result": "^OK skiprate rate=50 ",
   "note": "the SHIPPED rate, read not set"
  },
  {
   "seq": 13,
   "role": "h",
   "cmd": "regstate ${shop}",
   "expect_result": "^OK rented=True ",
   "capture": {
    "shopName": "name='([^']*)'"
   },
   "note": "the host's own clothing store"
  },
  {
   "seq": 14,
   "role": "h",
   "cmd": "skipvote 08:45",
   "expect_result": "^OK skipvote goal=",
   "expect_log": [
    {
     "role": "h",
     "regex": "\\[Rest\\] CONSENSUS \\(1/1\\)",
     "within_s": 60
    }
   ],
   "note": "SETUP skip, OUTDOORS, solo (1/1): 17:38 -> 08:45 next day (~18 real s at rate 50). Identical in every leg."
  },
  {
   "seq": 15,
   "role": "h",
   "sleep_s": 35
  },
  {
   "seq": 16,
   "role": "h",
   "cmd": "skipstate",
   "expect_result": "active=False"
  },
  {
   "seq": 17,
   "role": "h",
   "cmd": "skipvote off",
   "expect_result": "^OK skipvote goal=-"
  },
  {
   "seq": 18,
   "role": "h",
   "cmd": "schedcount ${shop}",
   "expect_result": "^OK schedcount",
   "capture": {
    "schedD1": "d1=(-?\\d+)",
    "schedD7": "d7=(-?\\d+)"
   },
   "note": "report: the fixture's staffed schedule (AI cashier on the register - NO working-player lever exists)"
  },
  {
   "seq": 19,
   "role": "h",
   "cmd": "enterbuilding ${shop}",
   "expect_result": "^OK enterbuilding",
   "note": "THE HOST STANDS IN HIS OWN SHOP: the occupied-shop path"
  },
  {
   "seq": 20,
   "role": "h",
   "sleep_s": 25,

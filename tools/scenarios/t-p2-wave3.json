{
  "id": "T-P2-WAVE3",
  "title": "phase-2 wave 3, two players: a routed work edit (driver slot) on the partner's shop lands on the owner's machine; own-shop edits stay local",
  "preconditions": "Fixture save1 (host melaus/Prabaha, client Client1/REX). Build with wave 3 deployed. Scenario ends dissolved.",
  "instances": 2,
  "vars": {
    "clientPid": "Client1",
    "hostPid": "melaus",
    "session": "save1"
  },
  "oracles_absent": [
    "NullReferenceException",
    "HarmonyException",
    "Patching exception",
    "\\[Merger\\] route for .* refused",
    "\\[Merger\\] accept .* REFUSED",
    "upload SKIPPED"
  ],
  "oracles_report": [
    "\\[Merger\\] work edit",
    "\\[Merger\\] staff op",
    "\\[SharedShop\\]"
  ],
  "steps": [
    {
      "seq": 1,
      "role": "h",
      "cmd": "host",
      "expect_result": "^OK"
    },
    {
      "seq": 2,
      "role": "c",
      "cmd": "join",
      "expect_result": "^OK"
    },
    {
      "seq": 3,
      "role": "h",
      "cmd": "hostload ${session}",
      "expect_result": "^OK"
    },
    {
      "seq": 4,
      "role": "both",
      "cmd": "mark TEST P2-WAVE3 START",
      "expect_result": "OK MARK"
    },
    {
      "seq": 5,
      "role": "h",
      "cmd": "merge propose ${clientPid}",
      "expect_result": "OK merge propose sent"
    },
    {
      "seq": 6,
      "role": "h",
      "sleep_s": 1
    },
    {
      "seq": 7,
      "role": "h",
      "cmd": "offers",
      "expect_result": "pending=\\[${clientPid}<-${hostPid}\\]"
    },
    {
      "seq": 8,
      "role": "c",
      "cmd": "merge accept",
      "expect_result": "OK merge accept sent"
    },
    {
      "seq": 9,
      "role": "h",
      "sleep_s": 3
    },
    {
      "seq": 10,
      "role": "h",
      "cmd": "mergestatus",
      "expect_result": "member=True.*flipped=[1-9]",
      "capture": {
        "clientShop": "keys=\\['([^']+)'"
      }
    },
    {
      "seq": 11,
      "role": "c",
      "cmd": "mergestatus",
      "expect_result": "member=True.*flipped=[1-9]",
      "capture": {
        "hostShop": "keys=\\['([^']+)'"
      }
    },
    {
      "seq": 12,
      "role": "h",
      "cmd": "warehouses",
      "expect_result": "^OK warehouses own=\\['",
      "capture": {
        "hostWh": "own=\\['([^']+)'"
      },
      "note": "the host's first own warehouse"
    },
    {
      "seq": 13,
      "role": "c",
      "cmd": "warehouses",
      "expect_result": "^OK warehouses own=\\['",
      "capture": {
        "clientWh": "own=\\['([^']+)'"
      },
      "note": "the client's first own warehouse"
    },
    {
      "seq": 14,
      "role": "c",
      "cmd": "workedit ${hostWh} driver1 -",
      "expect_result": "^OK workedit addr='${hostWh}' field='driver1' value='-' routed=True",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[(Merger|SharedShop)\\] work edit (applied on|'driver' on) '${hostWh}' from '${clientPid}'",
          "within_s": 20
        }
      ],
      "note": "member -> host -> owner (the host IS the owner): the owner's machine receives the routed driver-slot edit, gates it and answers (applied, or 'NOT applied - echoing truth back' when the fixture warehouse has no vehicle slots - the round trip is what this asserts)"
    },
    {
      "seq": 15,
      "role": "h",
      "cmd": "workedit ${clientWh} driver1 -",
      "expect_result": "^OK workedit addr='${clientWh}' field='driver1' value='-' routed=True",
      "expect_log": [
        {
          "role": "c",
          "regex": "\\[(Merger|SharedShop)\\] work edit (applied on|'driver' on) '${clientWh}' from '${hostPid}'",
          "within_s": 20
        }
      ],
      "note": "host member -> the client owner's machine receives, gates and answers the routed edit (applied or refused-with-echo)"
    },
    {
      "seq": 16,
      "role": "h",
      "cmd": "workedit ${hostWh} driver1 -",
      "expect_result": "^OK workedit addr='${hostWh}' field='driver1' value='-' routed=False",
      "note": "an own warehouse is never routed"
    },
    {
      "seq": 17,
      "role": "c",
      "cmd": "merge leave",
      "expect_result": "OK merge leave sent",
      "note": "FIXTURE HYGIENE: end dissolved"
    },
    {
      "seq": 18,
      "role": "h",
      "sleep_s": 3
    },
    {
      "seq": 19,
      "role": "h",
      "cmd": "mergestatus",
      "expect_result": "member=False.*flipped=0"
    },
    {
      "seq": 20,
      "role": "h",
      "cmd": "save",
      "expect_result": "^OK"
    },
    {
      "seq": 21,
      "role": "both",
      "cmd": "mark TEST P2-WAVE3 END",
      "expect_result": "OK MARK"
    }
  ]
}

      "cmd": "pause off",
      "expect_result": "^OK",
      "seq": 30
    },
    {
      "role": "h",
      "cmd": "pause off",
      "expect_result": "^OK",
      "seq": 31
    },
    {
      "role": "h",
      "sleep_s": 8,

      "sleep_s": 32,
      "note": "both worlds settle before anything is measured"
    },
    {
      "seq": 6,
      "role": "h",
      "cmd": "status",
      "expect_result": "settled=True"
    },
    {
      "seq": 7,
      "role": "c",
      "cmd": "status",
      "expect_result": "settled=True"
    },
    {
      "seq": 8,

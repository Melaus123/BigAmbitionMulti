        "cap": " cap=(-?\\d+)",
        "completeOrders": "completeOrders=(\\d+)",
        "livePays": "livePays=(-?\\d+)",
        "unpaidExits": "unpaidExits=(\\d+)",
        "paperHours": "paperHours=(\\d+)",
        "paperCandidates": "paperCandidates=(\\d+)",
        "paperOrders": "paperOrders=(\\d+)",
        "capDrops": "capDrops=(\\d+)",
        "endTill": "tillOrders=(\\d+)",

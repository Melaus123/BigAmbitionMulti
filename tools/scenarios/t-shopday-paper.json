    },
    {
      "seq": 18,
      "role": "h",
      "cmd": "skipvote off",
      "expect_result": "^OK skipvote goal=-"
    },
    {
      "seq": 19,
      "role": "c",
      "cmd": "skipvote off",
      "expect_result": "^OK skipvote goal=-"
    },
    {
      "seq": 20,
      "role": "h",
      "sleep_s": 5
    },

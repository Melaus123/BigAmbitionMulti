      "expect_result": "^OK skipvote goal="
    },
    {
      "seq": 41,
      "role": "h",
      "cmd": "skipvote +3h",
      "expect_result": "^OK skipvote goal=",
      "abort_on_fail": false,
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[Rest\\] CONSENSUS \\(2/2\\)",
          "within_s": 60
        }
      ],
      "note": "ONE consensus skip over the SAME three game hours the normal leg waits out - ~3.6 real seconds at rate 50"
    },
    {
      "seq": 42,
      "role": "h",

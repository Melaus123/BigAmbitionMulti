      "expect_result": "^OK"
    },
    {
      "seq": 10,
      "role": "h",
      "cmd": "exitbuilding",
      "abort_on_fail": false,
      "note": "fx-hq1 loads Client1 inside a building; report-only, an outdoor player only warns"
    },
    {
      "seq": 11,
      "role": "c",
      "cmd": "exitbuilding",
      "abort_on_fail": false
    },
    {
      "seq": 12,
      "role": "h",

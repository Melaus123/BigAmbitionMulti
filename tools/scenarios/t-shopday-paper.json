      "expect_result": "^OK skipvote goal=",
      "abort_on_fail": false,
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[Rest\\] CONSENSUS \\(2/2\\)",
          "within_s": 60
        }
      ],
      "note": "the SETUP skip: 17:38 -> 10:45 next day, ~20 s at rate 50, taken outdoors"
    },
    {
      "seq": 16,
      "role": "h",
      "sleep_s": 40
    },
    {
      "seq": 17,
      "role": "h",
      "cmd": "skipstate",

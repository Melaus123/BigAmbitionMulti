        "preTill": "tillOrders=(\\d+)",
        "preRev": "paidRevenue=([0-9.]+)",
        "preCap": "cap=(-?\\d+)",
        "preMinMult": "minMult=([0-9.]+)"
      },
      "note": "THE FLOW PREMISE: shoppers are still due today at this shop. Without this the leg could 'pass' on a dead shop and the table would compare two zeros."
    },
    {
      "seq": 34,
      "role": "c",
      "cmd": "shopday ${shop}",
      "expect_result": "live=[1-9]",
      "note": "THE SECOND HALF OF THE PREMISE: bodies are really standing on the floor at normal speed before the window opens."
    },
    {
      "seq": 35,
      "role": "c",
      "cmd": "perf reset",
      "expect_result": "^OK perf"
    },
    {
      "seq": 36,
      "role": "h",
      "cmd": "perf reset",
      "expect_result": "^OK perf"
    },
    {
      "seq": 37,
      "role": "c",

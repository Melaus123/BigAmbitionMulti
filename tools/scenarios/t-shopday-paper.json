      "expect_result": "^OK shopday reset"
    },
    {
      "seq": 38,
      "role": "h",
      "cmd": "shopday reset",
      "expect_result": "^OK shopday reset"
    },
    {
      "seq": 39,
      "role": "c",
      "cmd": "skipstate",
      "expect_result": "^OK skipstate",
      "capture": {

      "role": "h",
      "cmd": "cartstate ${emptyCart}",
      "expect_result": "^OK cartstate .* own=Y live=N tag='' lastSeen=Y cargo=0 cleared=Y omitted=Y ",
      "note": "OWNER: the game's own cleared-on-exit state, and not broadcast"
    },
    {
      "seq": 24,
      "role": "c",
      "cmd": "cartstate ${cargoCart}",

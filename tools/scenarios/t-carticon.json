        {
          "role": "h",
          "regex": "\\[Vehicle\\] CARTICON '${emptyCart}': an empty hand vehicle the game cleared",
          "within_s": 40
        },
        {
          "role": "c",
          "regex": "\\[Vehicle\\] Despawned ghost '${emptyCart}'",
          "within_s": 50

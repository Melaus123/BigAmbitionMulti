      "note": "PREMISE (GHOSTPIN): the client's cargo flatbed left inside 3 Fifth Avenue is held by the host, hidden outdoors"
    },
    {
      "seq": 14,
      "role": "both",
      "cmd": "mark TEST CARTICON STRAND",
      "expect_result": "OK MARK"
    },
    {
      "seq": 15,
      "role": "h",
      "cmd": "enterbuilding ${shop}",
      "expect_result": "^OK enterbuilding",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[TestDrive\\] enterbuilding '${shop}' . OK",
          "within_s": 30
        }
      ]
    },
    {
      "seq": 16,
      "role": "h",
      "sleep_s": 8
    },
    {
      "seq": 17,
      "role": "h",
      "cmd": "cartstrand ${emptyCart} -1.5",
      "expect_result": "^OK cartstrand .*tag='${shop}' cargo=0"
    },
    {
      "seq": 18,
      "role": "h",
      "sleep_s": 8
    },
    {
      "seq": 19,
      "role": "c",
      "cmd": "cartstate ${emptyCart}",

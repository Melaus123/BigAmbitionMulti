          "within_s": 30
        }
      ],
      "seq": 58
    },
    {
      "role": "h",
      "sleep_s": 15,
      "note": "several fleet ticks on the owner (the omission test runs every dormant pass)",
      "seq": 59
    },
    {
      "role": "c",
      "cmd": "cartstate ${cargoCart}",
      "expect_result": "^OK cartstate .* own=Y live=\\w tag='' .*cleared=N omitted=N ",
      "note": "THE FOLD: parked outdoors by a partner (empty tag, lastSeen as it was) - NOT treated as cleared, still broadcast",
      "seq": 60
    },
    {
      "role": "h",
      "cmd": "cartstate ${cargoCart}",

      "cmd": "enterbuilding ${shop}",
      "expect_result": "^OK enterbuilding",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[TestDrive\\] enterbuilding '${shop}' . OK",
          "within_s": 30
        }
      ]
    },
    {
      "seq": 38,
      "role": "h",
      "sleep_s": 10
    },
    {
      "seq": 39,
      "role": "h",
      "cmd": "cartstate ${emptyCart}",
      "expect_result": "^OK cartstate",
      "note": "REPORT: does the game load the cleared cart again (native SpawnPlayerVehicles(address) keys on the wiped street data)"
    },
    {
      "seq": 40,
      "role": "c",
      "cmd": "cartstate ${emptyCart}",

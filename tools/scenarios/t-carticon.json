      "seq": 41,
      "role": "h",
      "cmd": "exitbuilding",
      "expect_result": "^OK exitbuilding"
    },
    {
      "seq": 42,
      "role": "h",
      "sleep_s": 8
    },
    {
      "seq": 43,

      "cmd": "exitbuilding",
      "expect_result": "^OK exitbuilding",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[Vehicle\\] CARTICON '${emptyCart}': an empty hand vehicle the game cleared",
          "within_s": 40
        },
        {
          "role": "c",
          "regex": "\\[Vehicle\\] Despawned ghost '${emptyCart}'",
          "within_s": 50
        }
      ]
    },
    {
      "seq": 22,
      "role": "h",
      "sleep_s": 8
    },
    {
      "seq": 23,
      "role": "h",
      "cmd": "cartstate ${emptyCart}",
      "expect_result": "^OK cartstate .* own=Y live=N tag='' lastSeen=Y cargo=0 cleared=Y omitted=Y ",
      "note": "OWNER: the game's own cleared-on-exit state, and not broadcast"
    },
    {
      "seq": 24,
      "role": "c",
      "cmd": "cartstate ${cargoCart}",
      "expect_result": "^OK cartstate .* own=Y live=N tag='${cargoBldg}' .*cleared=N omitted=N ",
      "note": "OWNER (client): a cargo flatbed left inside keeps its tag natively and stays broadcast"
    },
    {
      "seq": 25,
      "role": "c",
      "cmd": "cartstate ${emptyCart}",
      "expect_result": "^OK cartstate .* ghost=none pin=none$",
      "note": "THE FIX: the partner outdoors holds no copy and no kept pin"
    },
    {
      "seq": 26,
      "role": "c",
      "cmd": "pinstate",
      "expect_result": "^OK pinstate .* mismatched=0 ",
      "note": "no kept pin differs from its ghost (the empty cart's id must be absent - checked by the report)"
    },
    {
      "seq": 27,
      "role": "c",
      "cmd": "cartstate ${car}",
      "expect_result": "^OK cartstate .* ghost=on ",
      "note": "the car parked outside is still shown"
    },
    {
      "seq": 28,
      "role": "h",
      "cmd": "cartstate ${cargoCart}",
      "expect_result": "^OK cartstate .* ghost=off pin=(off|none)$",
      "note": "GHOSTPIN: the cargo cart is still held, hidden outdoors with its pin"
    },
    {
      "seq": 29,
      "role": "both",
      "cmd": "mark TEST CARTICON PARTNER ENTERS",
      "expect_result": "OK MARK"
    },
    {
      "seq": 30,
      "role": "c",
      "cmd": "enterbuilding ${shop}",
      "expect_result": "^OK enterbuilding",
      "expect_log": [
        {
          "role": "c",
          "regex": "\\[TestDrive\\] enterbuilding '${shop}' . OK",
          "within_s": 30
        }
      ]
    },
    {
      "seq": 31,
      "role": "c",
      "sleep_s": 8
    },
    {
      "seq": 32,
      "role": "c",
      "cmd": "cartstate ${car}",
      "expect_result": "^OK cartstate .* ghost=(on|off) ",
      "note": "context only: the '' tag rule hides only CARTS from an indoor viewer, so the host's street car stays shown (run T-CARTICON-20260927-124206)"
    },
    {
      "seq": 33,
      "role": "c",
      "cmd": "cartstate ${emptyCart}",
      "expect_result": "^OK cartstate .* ghost=none pin=none$",
      "note": "the cleared cart does not come back inside either (the owner's game has it unloaded)"
    },
    {
      "seq": 34,
      "role": "c",
      "cmd": "exitbuilding",
      "expect_result": "^OK exitbuilding"
    },
    {
      "seq": 35,
      "role": "c",
      "sleep_s": 8
    },
    {
      "seq": 36,
      "role": "both",
      "cmd": "mark TEST CARTICON OWNER RE-ENTERS",
      "expect_result": "OK MARK"
    },
    {
      "seq": 37,
      "role": "h",
      "cmd": "enterbuilding ${shop}",
      "expect_result": "^OK enterbuilding",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[TestDrive\\] enterbuilding '${shop}' . OK",
          "within_s": 30
        }
      ]
    },
    {
      "seq": 38,
      "role": "h",
      "sleep_s": 10
    },
    {
      "seq": 39,
      "role": "h",
      "cmd": "cartstate ${emptyCart}",
      "expect_result": "^OK cartstate",
      "note": "REPORT: does the game load the cleared cart again (native SpawnPlayerVehicles(address) keys on the wiped street data)"
    },
    {
      "seq": 40,

{
  "id": "T-P4B-PEOPLE-B",
  "title": "phase 4b people build B, two players: a rival-poach raise request raised on the host relays to the client as a copy with the game's own two buttons; Accept pressed on the client's copy runs the original closure ONCE on the host (the raise) and every copy shows handled; a second press sends nothing; ends dissolved",
  "preconditions": "Fixture save1 (host melaus owns 6 ba:street_seventhstreet with 50 staff). Build B with the poachmsg lever (r4 fold): the game has only two sites that build native message buttons, both rival-poach raise requests, so the lever calls the game's own PoachByRival on one of the host's employees (percent 5, deadline 30 days so an aborted run never loses the employee); the message relays to the client through the normal gateway. The scenario presses ACCEPT (button 1) on the client's copy: the host applies the 5% raise once (a small permanent fixture change, like the training runs). Ends dissolved.",
  "instances": 2,
  "vars": {
    "clientPid": "Client1",
    "hostPid": "melaus",
    "session": "save1",
    "hostShop": "6 ba:street_seventhstreet"
  },
  "oracles_absent": [
    "NullReferenceException",
    "HarmonyException",
    "Patching exception",
    "\\[Merger\\] accept .* REFUSED",
    "upload SKIPPED",
    "\\[Messages\\] .*REFUSED",
    "\\[Messages\\] .*refused by the host"
  ],
  "oracles_report": [
    "\\[Messages\\]",
    "\\[Candidates\\] claim",
    "\\[TestDrive\\] message:"
  ],
  "steps": [
    {
      "seq": 1,
      "role": "h",
      "cmd": "host",
      "expect_result": "^OK"
    },
    {
      "seq": 2,
      "role": "c",
      "cmd": "join",
      "expect_result": "^OK"
    },
    {
      "seq": 3,
      "role": "h",
      "cmd": "hostload ${session}",
      "expect_result": "^OK"
    },
    {
      "seq": 4,
      "role": "both",
      "cmd": "mark TEST P4B-PEOPLE-B START",
      "expect_result": "OK MARK"
    },
    {
      "seq": 5,
      "role": "h",
      "cmd": "merge propose ${clientPid}",
      "expect_result": "OK merge propose sent"
    },
    {
      "seq": 6,
      "role": "h",
      "sleep_s": 1
    },
    {
      "seq": 7,
      "role": "h",
      "cmd": "offers",
      "expect_result": "pending=\\[${clientPid}<-${hostPid}\\]"
    },
    {
      "seq": 8,
      "role": "c",
      "cmd": "merge accept",
      "expect_result": "OK merge accept sent"
    },
    {
      "seq": 9,
      "role": "h",
      "sleep_s": 3
    },
    {
      "seq": 10,
      "role": "h",
      "cmd": "mergestatus",
      "expect_result": "member=True.*flipped=[1-9]"
    },
    {
      "seq": 11,
      "role": "h",
      "sleep_s": 30,
      "note": "the client's world needs to settle"
    },
    {
      "seq": 12,
      "role": "c",
      "cmd": "status",
      "expect_result": "settled=True"
    },
    {
      "seq": 13,
      "role": "h",
      "cmd": "employees ${hostShop}",
      "expect_result": "^OK [1-9]\\d* employee\\(s\\) @ '${hostShop}': ",
      "note": "one of the host's OWN employees at its shop (injected=False, not a duty synthetic)",
      "capture": {
        "hostEmp": "(?:': |; )((?!BAMP_DUTY)[^|]+)\\|[^|]*\\|assigned=[^|]*\\|injected=False"
      }
    },
    {
      "seq": 14,
      "role": "h",
      "cmd": "poachmsg ${hostEmp} 5 30",
      "expect_result": "^OK poachmsg employee='${hostEmp}' rival='[^']+' percent=5 days=30 wage=",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[Messages\\] relaying 'ba:messagetype_rivals_poach[^']*' on '.*' as bamp-msg-[0-9a-f]+ \\(2 button\\(s\\)",
          "within_s": 15
        },
        {
          "role": "c",
          "regex": "\\[Messages\\] bamp-msg-[0-9a-f]+: 'ba:messagetype_rivals_poach[^']*' from '${hostPid}' shown on '.*' \\(2 button\\(s\\)\\)",
          "within_s": 20
        }
      ],
      "note": "the game's own PoachByRival raises the raise request with Decline [0] / Accept [1]; the relay postfix sends it; the client shows the copy with both buttons"
    },
    {
      "seq": 15,
      "role": "c",
      "cmd": "messages 5",
      "expect_result": "\\|copy\\|origin=${hostPid}\\|contact=[^|]*\\|key=ba:messagetype_rivals_poach[^|]*\\|buttons=2\\|read=False\\|handled=False",
      "note": "the client's copy id, with both buttons, unread, not handled",
      "capture": {
        "copyId": "(bamp-msg-[0-9a-f]+)\\|copy\\|origin=${hostPid}\\|contact=[^|]*\\|key=ba:messagetype_rivals_poach[^|]*\\|buttons=2"
      }
    },
    {
      "seq": 16,
      "role": "c",
      "cmd": "press ${copyId} 1",
      "expect_result": "^OK press message='${copyId}' button=1 sent=True",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[Messages\\] ${copyId}: button 1 run here - handled by '${clientPid}'",
          "within_s": 20
        },
        {
          "role": "c",
          "regex": "\\[Messages\\] ${copyId}: handled by '${clientPid}' - this copy is read and its buttons are done",
          "within_s": 20
        }
      ],
      "note": "the routed press: ACCEPT runs once on the host (AcceptPoachPayRaise - the 5% raise); every copy marks handled"
    },
    {
      "seq": 17,
      "role": "c",
      "cmd": "press ${copyId} 1",
      "expect_result": "^OK press message='${copyId}' button=1 sent=False reason='handled'",
      "note": "idempotent: a second press on a handled copy sends nothing"
    },
    {
      "seq": 18,
      "role": "c",
      "cmd": "merge leave",
      "expect_result": "OK merge leave sent",
      "note": "FIXTURE HYGIENE: end dissolved"
    },
    {
      "seq": 19,
      "role": "h",
      "sleep_s": 3
    },
    {
      "seq": 20,
      "role": "h",
      "cmd": "mergestatus",
      "expect_result": "member=False.*flipped=0"
    },
    {
      "seq": 21,
      "role": "h",
      "cmd": "save",
      "expect_result": "^OK"
    },
    {
      "seq": 22,
      "role": "both",
      "cmd": "mark TEST P4B-PEOPLE-B END",
      "expect_result": "OK MARK"
    }
  ]
}

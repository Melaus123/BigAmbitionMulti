{
  "id": "T-SAVEDSETTINGS",
  "title": "SAVED-SETTINGS-1 (user-approved 2026-09-29, decisions 18/20/21): the settings window in the lobby's card style in both modes; in a SAVED game it shows the save's real values (fixture save1: StartSettings), Days per year and the already-on All courses / All contacts are locked; 15 flexible values changed through the window's own paths are applied at the host's world-ready through the game's ApplyNewDifficulty and delivered to every client (lobby-start load, a brand-new mid-session joiner, a rejoin) - every machine logs the same rev and hash, rigid values kept; functional spot checks on a client (wholesale x1.30, sell-back 50%, no fuel use); save + relaunch + reload shows the edited values (manifest WorldSettings rev=1) and a no-change load applies nothing anywhere.",
  "preconditions": "Dev build with the 'uiview ss*' levers (MPCanvasUI.DevUi) and 'worldvars' (TestDrive.cs). Fixture save1 (host melaus, client Client1); the third instance (role d, Client2) joins mid-session as a NEW player (charconfirm armed). Uses the driver's drop/relaunch steps. Screenshots at the host's own window size (1920x1080).",
  "instances": 3,
  "vars": {
    "clientPid": "Client1",
    "hostPid": "melaus",
    "dPid": "Client2",
    "session": "save1"
  },
  "oracles_absent": [
    "\\[World\\] settings apply rev=",
    "\\[World\\] host apply at ",
    "\\[World\\] send to ",
    "\\[World\\] client receive: ",
    "\\[World\\] client world-ready: ",
    "\\[World\\] rev check: ",
    "\\[World\\] world-ready: ",
    "\\[World\\] manifest stamp: ",
    "\\[MenuUI\\] saved world settings seed: ",
    "\\[MenuUI\\] saved world settings: ",
    "\\[UI\\] settings tooltip: ",
    "\\[UI\\] BuildSettingsPanel rebuild failed",
    "rigidKept=False",
    "\\[World\\] settings rev=\\d+ \\(client(, held)?\\) not applied - rev not recorded"
  ],
  "oracles_report": [
    "\\[World\\] ",
    "\\[MenuUI\\] saved world settings",
    "\\[UI\\] settings window built",
    "\\[TestDrive\\] worldvars",
    "\\[TestDrive\\] screenshot "
  ],
  "steps": [
    {
      "seq": 1,
      "role": "all",
      "cmd": "mark TEST SAVEDSETTINGS START",
      "expect_result": "OK MARK"
    },
    {
      "seq": 2,
      "role": "all",
      "sleep_s": 20,
      "note": "let the main menu finish building before the first lever"
    },
    {
      "seq": 3,
      "role": "h",
      "cmd": "uiview host",
      "expect_result": "^OK uiview host: server=True",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[Server\\] Listening on port",
          "within_s": 30
        }
      ]
    },
    {
      "seq": 4,
      "role": "h",
      "cmd": "uiview ssopen",
      "expect_result": "^OK uiview ssopen: open=True mode=new rows=23 locked=\\[\\]",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[UI\\] settings window built: mode=new worldRows=True daysLocked=False",
          "within_s": 10
        }
      ]
    },
    {
      "seq": 5,
      "role": "h",
      "sleep_s": 2
    },
    {
      "seq": 6,
      "role": "h",
      "cmd": "screenshot ss-new-1920",
      "expect_result": "^OK screenshot queued",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[TestDrive\\] screenshot .*shot-ss\\-new\\-1920\\.png",
          "within_s": 10
        }
      ]
    },
    {
      "seq": 7,
      "role": "h",
      "cmd": "uiview sstip Tax %",
      "expect_result": "^OK uiview sstip: tip 'Tax %': Percent of profit paid as income tax each period\\.$"
    },
    {
      "seq": 8,
      "role": "h",
      "sleep_s": 2
    },
    {
      "seq": 9,
      "role": "h",
      "cmd": "screenshot ss-new-tip-1920",
      "expect_result": "^OK screenshot queued",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[TestDrive\\] screenshot .*shot-ss\\-new\\-tip\\-1920\\.png",
          "within_s": 10

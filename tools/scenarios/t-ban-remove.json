      "seq": 31
    },
    {
      "role": "h",
      "sleep_s": 20,
      "seq": 32
    },
    {
      "role": "h",
      "cmd": "host",
      "expect_result": "^OK server started",
      "seq": 33
    },
    {
      "role": "h",
      "cmd": "hostload ${session}",
      "expect_result": "^OK",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[Forfeit\\] restored 1 forfeit record\\(s\\) \\([1-9]\\d* address\\(es\\)\\) from the manifest\\.",

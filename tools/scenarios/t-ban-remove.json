{
  "id": "T-BAN-REMOVE",
  "title": "BAN-PLAYERS-1 build B (remove property): (1) a connected client banned WITH removal - every address it held is released on the host and the other client (contents gone, ledger entries gone, forfeit record kept); (2) after a host save + restart the record is restored and nothing comes back; (3) unban + rejoin - the client's own machine ends those leases with no payout; (4) ban without removal then remove from the offline entry; (5) a merged member's absence mark is dropped and the stand-in stops.",
  "preconditions": "Dev build with the 'ban remove/held/forfeits' and 'bldgstate' levers. Fixture save1 (host melaus, client Client1 holding several buildings) plus the third instance (Client2, no slot in save1 - charconfirm before hostload). The saved ban list is emptied at start and end.",
  "instances": 3,
  "vars": {
    "clientPid": "Client1",
    "hostPid": "melaus",
    "dPid": "Client2",
    "session": "save1"
  },
  "oracles_absent": [
    "NullReferenceException",
    "\\[Forfeit\\] RemoveProperty\\(",
    "\\[Forfeit\\] (receive|held release|manifest (snapshot|restore)|reset|record cleared .*hosting|send to '|apply for '|check '|re-acquire note)",
    "\\[Forfeit\\] viewer '[^']+' (REFUSED|: )",
    "\\[Forfeit\\] .*(vehicle delete|ShutdownBusiness:|purchasing plans:|listing failed)",
    "\\[Forfeit\\] remove property of .* REFUSED"
  ],
  "oracles_report": [
    "\\[Forfeit\\]",
    "\\[(Ledger|LedgerHeal)\\].*ADOPTED",
    "\\[Contested\\] '.*' is claimed by BOTH",
    "\\[Server\\] (BANNED|UNBANNED)",
    "\\[Absence\\] mark for",
    "\\[Merger\\] flip OFF",
    "\\[Lease\\]"
  ],
  "steps": [
    {
      "role": "all",
      "cmd": "mark TEST BANREM START",
      "expect_result": "OK MARK",
      "seq": 1
    },
    {
      "role": "h",
      "cmd": "unban all",
      "expect_result": "^OK unbanned \\d+ left=0",
      "note": "hygiene: no saved ban left from an aborted run",
      "seq": 2
    },
    {
      "role": "h",
      "cmd": "host",
      "expect_result": "^OK",
      "seq": 3
    },
    {
      "role": "c",
      "cmd": "join",
      "expect_result": "^OK",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[Server\\] '${clientPid}' joined lobby\\.",
          "within_s": 60
        }
      ],
      "seq": 4
    },
    {
      "role": "d",
      "cmd": "join",
      "expect_result": "^OK",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[Server\\] '${dPid}' joined lobby\\.",
          "within_s": 60
        }
      ],
      "seq": 5
    },
    {
      "role": "d",
      "cmd": "charconfirm",
      "expect_result": "^OK",
      "seq": 6
    },
    {
      "role": "h",
      "sleep_s": 3,
      "seq": 7
    },
    {
      "role": "h",
      "cmd": "hostload ${session}",
      "expect_result": "^OK",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[BAMP\\] \\[LoadProf\\].*HOST ReleaseStartupHold \\(all players world-ready\\)",
          "within_s": 300
        },
        {
          "role": "h",
          "regex": "\\[BAMP\\] \\[Lifecycle\\] WorldReady",
          "within_s": 60
        }
      ],
      "seq": 8
    },
    {
      "role": "h",
      "sleep_s": 30,
      "seq": 9
    },
    {
      "role": "all",
      "cmd": "mark TEST BANREM PREMISE",
      "expect_result": "OK MARK",
      "seq": 10
    },
    {
      "role": "h",
      "cmd": "ban held ${clientPid}",
      "expect_result": "^OK held '${clientPid}' stable=\\S+ rented=[1-9]\\d* bought=\\d+ richest=\\[",
      "capture": {
        "shopA": "richest=\\[([^\\]]+)\\]",
        "clientStable": "stable=(\\S+)"
      },
      "note": "premise (1): the client holds buildings in the host ledgers; shopA = the first",
      "seq": 11
    },
    {
      "role": "h",
      "cmd": "bldgstate ${shopA}",
      "expect_result": "^OK bldg .* ledger=${clientPid} ",
      "expect_gt": {
        "items=(\\d+)": 0
      },
      "abort_on_fail": false,
      "note": "premise: the host's copy of shopA holds contents (not aborting: a false premise is a finding)",
      "seq": 12
    },
    {
      "role": "d",
      "cmd": "bldgstate ${shopA}",
      "expect_result": "^OK bldg ",
      "note": "the other client's copy before (report)",
      "seq": 13
    },
    {
      "role": "c",
      "cmd": "bldgstate ${shopA}",
      "expect_result": "^OK bldg .* rented=True ",
      "note": "premise: the client rents shopA on its own machine",
      "seq": 14
    },
    {
      "role": "c",
      "cmd": "money",
      "expect_result": "^OK money=",
      "note": "report: the client's wallet before the ban",
      "seq": 15
    },
    {
      "role": "all",
      "cmd": "mark TEST BANREM LEG1",
      "expect_result": "OK MARK",
      "seq": 16
    },
    {
      "role": "h",
      "cmd": "ban ${clientPid}",
      "expect_result": "^OK banned '${clientPid}' key=(\\S+) stable=yes",
      "capture": {
        "banKey": "key=(\\S+)"
      },
      "expect_log": [
        {
          "role": "c",
          "regex": "\\[Client\\] disconnect reason tag: 'BAMP:bannedgame'",
          "within_s": 30
        }
      ],
      "seq": 17
    },
    {
      "role": "h",
      "sleep_s": 3,
      "seq": 18
    },
    {
      "role": "h",
      "cmd": "ban remove ${banKey}",
      "expect_result": "^OK removed '${clientPid}' key=${banKey} rented=[1-9]\\d* bought=\\d+ cleared=[1-9]\\d* mark=none addrs=\\[.*${shopA}",
      "note": "(1) WITH removal at ban time: ledger entries gone, host copy released, every connected machine told",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[Forfeit\\] REMOVED the property of banned '${clientPid}'",
          "within_s": 10
        },
        {
          "role": "h",
          "regex": "\\[Forfeit\\] host '${shopA}' released",
          "within_s": 10
        },
        {
          "role": "d",
          "regex": "\\[Forfeit\\] viewer apply for '${clientPid}' \\(removed\\): [1-9]\\d* address\\(es\\) released",
          "within_s": 30
        },
        {
          "role": "h",
          "regex": "\\[MPSave\\] HostSaveNow session='${session}' reason=forfeit",
          "within_s": 120
        }
      ],
      "seq": 19
    },
    {
      "role": "h",
      "sleep_s": 3,
      "seq": 20
    },
    {
      "role": "h",
      "cmd": "bldgstate ${shopA}",
      "expect_result": "^OK bldg .* rented=False forRent=True .*name='' type=ba:businesstype_empty .*items=0 vehicles=0 ledger=- deed=- ",
      "seq": 21
    },
    {
      "role": "d",
      "cmd": "bldgstate ${shopA}",
      "expect_result": "^OK bldg .* rented=False forRent=True .*name='' .*items=0 vehicles=0 ",
      "seq": 22
    },
    {
      "role": "h",

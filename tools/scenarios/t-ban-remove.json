      "seq": 27
    },
    {
      "role": "h",
      "sleep_s": 15,
      "seq": 28
    },
    {
      "role": "all",
      "cmd": "mark TEST BANREM LEG2",
      "expect_result": "OK MARK",
      "seq": 29
    },

        {
          "role": "h",
          "regex": "\\[BAMP\\] \\[Lifecycle\\] WorldReady",
          "within_s": 300
        },
        {
          "role": "h",
          "regex": "\\[Forfeit\\] world load \\(world-ready\\): reapplied=1 .* at ${shopA}",
          "within_s": 300
        }
      ],
      "note": "(2) host restart: the record comes back with the ledgers; F3: the world load re-applies the record to the host's own copy (the stale tenancy goes)",
      "seq": 34
    },
    {
      "role": "h",
      "sleep_s": 40,
      "seq": 35
    },
    {
      "role": "h",
      "cmd": "ban forfeits",
      "expect_result": "^OK forfeits n=1 \\[${clientStable} '${clientPid}' .*${shopA}",
      "seq": 36
    },
    {
      "role": "h",
      "cmd": "bldgstate ${shopA}",
      "expect_result": "^OK bldg .* rented=False forRent=True .*items=0 .*ledger=- deed=- ",
      "seq": 37
    },
    {
      "role": "h",

    },
    {
      "role": "h",
      "sleep_s": 5,
      "seq": 46
    },
    {
      "role": "h",
      "cmd": "acceptjoin",
      "expect_result": "^OK",
      "note": "(3) unban + rejoin: the client's OWN machine ends those leases with no payout (wallet before == after inside the apply)",
      "expect_log": [
        {
          "role": "h",
          "regex": "\\[Forfeit\\] record sent to '${clientPid}' \\(world-ready re-send\\): .* - including that player's OWN forfeited property",
          "within_s": 240
        },
        {
          "role": "c",
          "regex": "\\[Forfeit\\] own lease '${shopA}' ENDED",
          "within_s": 240
        },
        {
          "role": "c",
          "regex": "\\[Forfeit\\] OWN property removed by the host's ban \\(day \\d+, world-ready re-send\\): [1-9]\\d* lease\\(s\\) ended, \\d+ bought building\\(s\\) given up, \\d+ already released; \\d+ item\\(s\\) and \\d+ vehicle\\(s\\) removed; no payout - money before=(\\S+) after=\\1\\.",
          "within_s": 240
        }
      ],
      "seq": 47
    },
    {
      "role": "c",
      "sleep_s": 30,
      "seq": 48
